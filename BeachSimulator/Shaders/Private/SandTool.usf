// M2 T2 — 도구 스탬프 (m2-plan.md). 시뮬 스텝 맨 앞(system-design 패스 0)에서 소비한다. CPU 는 스탬프 구조체만 올린다.
//
//   StampCS     입자별: 배수 이완 → 스탬프를 순서대로 (파기 = 손으로 옮김 · 물붓기 = W 올림 + 아래로 충격)
//   PileCS      입자별 (무덤만): 손 재고를 뒤에서부터 하나씩 꺼내 놓을 자리로 — W 같이, 결합 검사 표시 (T3)
//   PileFinishCS  재고 수에서 쌓은 수를 뺀다
//   BondToolCS  결합별: 무덤에 간 입자의 결합은 끊고 (x < 0), 입자별 W 모드면 쌍 cohesion 을 W 에서 다시 (W3 · C16)
//
// 죽은 입자 = 무덤 자리에 고정 (SandSurface.h SandPool, T1). 손 재고 = HandW (넣은 순서 큐, T3 이 꺼낸다)

#include "/Engine/Public/Platform.ush"

#define TOOL_DIG  0u
#define TOOL_POUR 1u

uint  NumParticles;
uint  NumBonds;
uint  NumStamps;
uint  StampSeed;                 // 프레임마다 바뀌는 난수 씨앗 (파기 세기 < 1 의 확률)
uint  HandCap;
uint  SleepFrames;
float GraveZ;
float GraveSpacing;
float StepDt;
float DrainTarget;               // 이 W 위면 DrainTau 로 이완 (M2 임시 배수, M5 에서 교체). DrainTau 0 = 끔
float DrainTau;
uint  bPerParticleWet;
// cohesion(W) 제어점 (FSandSpike::CohesionOfW 와 같다). 한 줄 여러 선언은 UE 매개변수 파서가 못 읽는다
float WDry;
float WOptStart;
float WOptEnd;
float WSat;
// M4 T3 젖음 (m4-plan T3): 격자 물이 닿은 입자는 포화 (W = 1). 물 닿음 = 입자가 가로로 R 안에 걸친 칸 중 h > 3 mm 인 칸의 수면 아래로 입자 밑이 들어감
uint   WetMode;
uint   GroundNX;
uint   GroundNY;
float  GroundCell;
float2 GroundOrigin;
float  GroundZ;
float  WetRadius;
StructuredBuffer<float>  GroundBed;     // 물이 보는 유효 바닥 (b + b_struct, m, 꼭짓점)
StructuredBuffer<float4> GroundWater;   // 격자 상태 U0 (x = 수면 w, m, 칸)

uint  NumPileTargets;
float PileDropVel;
StructuredBuffer<float4>   PileTargets;  // 쌓기 놓을 자리 (CPU 가 지터 격자로 만든다)
StructuredBuffer<float4>   Stamps;       // 스탬프마다 2 개: (중심 xyz, 반지름) · (종류, 세기, W 증가, 충격 속도)
RWStructuredBuffer<float4> PosRW;
RWStructuredBuffer<float4> VelRW;
RWStructuredBuffer<float4> PrevPosRW;
RWStructuredBuffer<float>  WetRW;
StructuredBuffer<float>    WetRO;
RWStructuredBuffer<uint>   SleepRW;
RWStructuredBuffer<float>  GroundLambdaRW;
RWStructuredBuffer<float4> WallLambdaRW;
RWStructuredBuffer<float>  HandWRW;      // 손 재고의 W (넣은 순서)
RWStructuredBuffer<uint>   HandCountRW;  // [0] 재고 수 · [1] 이 프레임 판 수 · [2] 손이 차서 못 판 수 · [3] 쌓기 차례 (끝나면 쌓은 수)
StructuredBuffer<uint>     BondIJ;
RWStructuredBuffer<float4> BondDataRW;   // x 휴지 길이(음수 = 죽음) · y λ · z 쌍 cohesion

// 사건 결합 생성 (아래 BondFormCS)
uint  NumPairsMax;               // 쌍 버퍼 용량 (실제 수는 FrameCounts[0])
uint  BondCap;
uint  BondSlots;
float FormRange;                 // D · BondFormStretch
float FormMinRest;               // D
StructuredBuffer<uint>     PairIJ;       // 풀이 순서 쌍 (2k, 2k+1)
StructuredBuffer<uint>     FrameCounts;  // [0] 쌍 수
StructuredBuffer<uint>     BondTrig;     // 1 = 이번 프레임 결합 검사 대상
RWStructuredBuffer<uint>   BondTrigRW;
RWStructuredBuffer<uint>   BondSlotRW;   // 입자별 산 결합 수
StructuredBuffer<uint>     OldAdjOffset;
StructuredBuffer<uint>     OldAdj;
RWStructuredBuffer<uint>   BondIJRW;
RWStructuredBuffer<uint>   BondTotalRW;  // [0] 결합 칸 수 (산 것 + 죽은 것) · [1] 생성 수 · [2] 슬롯 · 용량 넘침
RWStructuredBuffer<uint>   BondAdjRW;
RWStructuredBuffer<uint>   BondCursorRW;
StructuredBuffer<uint>     BondAdjOffsetRO;
// 죽은 결합 칸 압축 (A2) — 사건 결합 프레임 앞에서. Remap = 산 표시의 배타 스캔 (Remap[b+1] − Remap[b] = 1 이면 산 것)
RWStructuredBuffer<uint>   BondFlagRW;
StructuredBuffer<uint>     BondRemap;
RWStructuredBuffer<uint>   TempIJRW;
RWStructuredBuffer<float4> TempDataRW;

float3 GravePos(uint i) { return float3(GraveZ + (i % 1024u) * GraveSpacing, GraveZ + (i / 1024u) * GraveSpacing, GraveZ); }
bool IsGrave(float3 P) { return P.z >= 0.5f * GraveZ; }

uint Hash(uint x)
{
	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
	return x;
}

float CohesionOfW(float W)
{
	if (W <= WDry || W >= WSat) { return 0.f; }
	if (W < WOptStart) { return (W - WDry) / max(WOptStart - WDry, 1.e-4f); }
	if (W <= WOptEnd) { return 1.f; }
	return (WSat - W) / max(WSat - WOptEnd, 1.e-4f);
}

[numthreads(64, 1, 1)]
void StampCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint p = Tid.x;
	if (p >= NumParticles) { return; }
	float4 P4 = PosRW[p];
	if (IsGrave(P4.xyz)) { return; }
	const uint Sl = SleepRW[p];
	const bool bAsleep = Sl >= SleepFrames && SleepFrames > 0u;
	const bool bFree = P4.w > 0.f || bAsleep;   // 고정(바닥) 입자는 도구가 건드리지 않는다
	if (!bFree) { return; }

	float W = WetRW[p];
	if (DrainTau > 0.f && W > DrainTarget) { W -= (W - DrainTarget) * min(1.f, StepDt / DrainTau); }
	if (WetMode != 0u && W < 1.f)
	{
		const float2 G = (P4.xy - GroundOrigin) / GroundCell;
		const int ci = (int)floor(G.x), cj = (int)floor(G.y);
		const uint W1 = GroundNX + 1u;
		float Surf = -1.e30f;
		for (int dj = -1; dj <= 1; ++dj)
		for (int di = -1; di <= 1; ++di)
		{
			const int i = ci + di, j = cj + dj;
			if (i < 0 || j < 0 || i >= (int)GroundNX || j >= (int)GroundNY) { continue; }
			// 칸 사각형까지 가로 거리 ≤ R 이면 입자가 그 칸에 걸친다
			const float2 Lo = GroundOrigin + float2(i, j) * GroundCell, Hi = Lo + GroundCell;
			const float2 Dd = max(0.f, max(Lo - P4.xy, P4.xy - Hi));
			if (dot(Dd, Dd) > WetRadius * WetRadius) { continue; }
			const uint c = (uint)j * W1 + (uint)i;
			const float w = GroundWater[(uint)j * GroundNX + (uint)i].x;
			const float h = w - 0.25f * (GroundBed[c] + GroundBed[c + 1u] + GroundBed[c + W1] + GroundBed[c + W1 + 1u]);
			if (h > 0.003f) { Surf = max(Surf, w); }
		}
		if (P4.z - WetRadius < GroundZ + 100.f * Surf) { W = 1.f; }
	}

	float3 V = VelRW[p].xyz;
	bool bWake = false;
	for (uint s = 0; s < NumStamps; ++s)
	{
		const float4 A = Stamps[2 * s], B = Stamps[2 * s + 1];
		const float3 d = P4.xyz - A.xyz;
		const float R2 = A.w * A.w;
		const float D2 = dot(d, d);
		if (D2 >= R2) { continue; }
		const uint Kind = (uint)B.x;
		if (Kind == TOOL_DIG)
		{
			// 세기 < 1 이면 확률로 일부만 — 깎기 감
			const float U = (Hash(p * 0x9E3779B1u ^ Hash(StampSeed * 64u + s)) & 0xFFFFFFu) / 16777216.f;
			if (U >= B.y) { continue; }
			uint Slot;
			InterlockedAdd(HandCountRW[0], 1u, Slot);
			if (Slot >= HandCap)
			{
				uint Dummy;
				InterlockedAdd(HandCountRW[0], 0xFFFFFFFFu, Dummy);
				InterlockedAdd(HandCountRW[2], 1u, Dummy);
				continue;
			}
			HandWRW[Slot] = W;
			uint Dummy2;
			InterlockedAdd(HandCountRW[1], 1u, Dummy2);
			const float3 G = GravePos(p);
			PosRW[p] = float4(G, 0.f);
			PrevPosRW[p] = float4(G, 0.f);
			VelRW[p] = 0;
			GroundLambdaRW[p] = 0.f;
			WallLambdaRW[p] = 0;
			SleepRW[p] = 0u;
			WetRW[p] = W;
			return;
		}
		else
		{
			// 물붓기 — 가운데일수록 많이 (1 − d²/r²). W 상한 1. 낙하 충격은 아래로 속도
			const float K = 1.f - D2 / R2;
			W = min(1.f, W + B.z * K);
			V.z -= B.w * K;
			bWake = true;
			if (B.z > 0.f) { BondTrigRW[p] = 1u; }   // 젖음이 올랐다 → 이번 프레임 결합 검사 (사건 결합)
		}
	}
	WetRW[p] = W;
	if (bWake)
	{
		VelRW[p] = float4(V, 0.f);
		if (bAsleep) { SleepRW[p] = 0u; PosRW[p] = float4(P4.xyz, 1.f); }
	}
}

[numthreads(64, 1, 1)]
void PileCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint p = Tid.x;
	if (p >= NumParticles) { return; }
	if (!IsGrave(PosRW[p].xyz)) { return; }
	const uint H = HandCountRW[0];   // 이 패스에선 아무도 [0] 을 쓰지 않는다 (PileFinishCS 가 뒤에)
	const uint K = min(H, NumPileTargets);
	if (K == 0u) { return; }
	uint c;
	InterlockedAdd(HandCountRW[3], 1u, c);
	if (c >= K) { return; }
	const float W = HandWRW[H - 1u - c];   // 뒤에 넣은 것부터 (손 위에 있는 모래)
	const float3 X = PileTargets[c].xyz;
	PosRW[p] = float4(X, 1.f);
	PrevPosRW[p] = float4(X, 1.f);
	VelRW[p] = float4(0.f, 0.f, -PileDropVel, 0.f);
	GroundLambdaRW[p] = 0.f;
	WallLambdaRW[p] = 0;
	SleepRW[p] = 0u;
	WetRW[p] = W;
	BondTrigRW[p] = 1u;   // 쌓기 = 누르는 사건 → 닿은 쌍 결합 검사 (결정 A). W ≤ W_dry 면 BondFormCS 가 거른다
}

[numthreads(1, 1, 1)]
void PileFinishCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint Taken = min(HandCountRW[3], min(HandCountRW[0], NumPileTargets));
	HandCountRW[0] -= Taken;
	HandCountRW[3] = Taken;
}

[numthreads(64, 1, 1)]
void BondToolCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint b = Tid.x;
	if (b >= NumBonds) { return; }
	float4 D = BondDataRW[b];
	if (D.x < 0.f) { return; }
	const uint i = BondIJ[2 * b], j = BondIJ[2 * b + 1];
	if (IsGrave(PosRW[i].xyz) || IsGrave(PosRW[j].xyz)) { D.x = -1.f; BondDataRW[b] = D; return; }
	if (bPerParticleWet != 0u)
	{
		D.z = CohesionOfW(0.5f * (WetRO[i] + WetRO[j]));
		BondDataRW[b] = D;
	}
}

// ------------------------------------------------------------------------------------------------
// 사건 결합 생성 (m2-log #3, papers C17 · m2-plan 결정 A). 물붓기 · 쌓기가 표시한 입자(BondTrig)의 닿은 쌍에만 다리를 만든다.
// 생성 기준 = 문헌 (Mani 2012 · Roy 2018): 닿음 (거리 < D · BondFormStretch) · 양쪽 W > W_dry · 쌍 cohesion > 0 · 슬롯 남음.
// 저절로 다시 붙지는 않는다 (m0-spike ①) — 사건이 없는 프레임엔 돌지 않는다.
//
//   BondSlotCountCS  산 결합 → 입자별 결합 수 (슬롯)
//   BondFormCS       이번 프레임 쌍 목록(풀이 순서)에서 생성 — 뒤에 덧붙인다 (원자 계수)
//   (스캔)           입자별 결합 수 → BondAdjOffset
//   BondFillCS       산 결합 → 인접 목록 (죽은 결합은 빠진다. 저장 칸은 CPU 가 가끔 압축)


[numthreads(64, 1, 1)]
void BondSlotCountCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint b = Tid.x;
	if (b >= NumBonds) { return; }
	if (BondDataRW[b].x < 0.f) { return; }
	uint D0;
	InterlockedAdd(BondSlotRW[BondIJRW[2 * b]], 1u, D0);
	InterlockedAdd(BondSlotRW[BondIJRW[2 * b + 1]], 1u, D0);
}

// ---- 압축: 산 표시 → (스캔) → 새 칸으로 옮김 → 칸 수 = 산 수
[numthreads(64, 1, 1)]
void BondAliveCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint b = Tid.x;
	if (b >= NumBonds) { return; }
	BondFlagRW[b] = BondDataRW[b].x >= 0.f ? 1u : 0u;
	TempDataRW[b] = float4(-1.f, 0.f, 0.f, 0.f);
}

[numthreads(64, 1, 1)]
void BondCompactCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint b = Tid.x;
	if (b >= NumBonds) { return; }
	const uint n = BondRemap[b];
	if (BondRemap[b + 1] == n) { return; }
	TempIJRW[2 * n] = BondIJRW[2 * b];
	TempIJRW[2 * n + 1] = BondIJRW[2 * b + 1];
	TempDataRW[n] = BondDataRW[b];
}

[numthreads(1, 1, 1)]
void BondCompactCountCS(uint3 Tid : SV_DispatchThreadID)
{
	BondTotalRW[0] = BondRemap[NumBonds];
	BondTotalRW[3] = NumBonds - BondRemap[NumBonds];   // 이번에 비운 칸
}

bool HasBond(uint i, uint j)
{
	// 옛 인접 목록은 압축 전 번호 — Remap 으로 새 번호로
	for (uint e = OldAdjOffset[i]; e < OldAdjOffset[i + 1]; ++e)
	{
		const uint A = OldAdj[e];
		const uint b0 = A >> 1;
		if (BondRemap[b0 + 1] == BondRemap[b0]) { continue; }
		const uint b = BondRemap[b0];
		if (BondDataRW[b].x < 0.f) { continue; }
		const uint Other = (A & 1u) ? BondIJRW[2 * b] : BondIJRW[2 * b + 1];
		if (Other == j) { return true; }
	}
	return false;
}

bool TakeSlot(uint p)
{
	uint Old;
	InterlockedAdd(BondSlotRW[p], 1u, Old);
	if (Old < BondSlots) { return true; }
	InterlockedAdd(BondSlotRW[p], 0xFFFFFFFFu, Old);
	return false;
}

[numthreads(64, 1, 1)]
void BondFormCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint k = Tid.x;
	if (k >= min(FrameCounts[0], NumPairsMax)) { return; }
	const uint i = PairIJ[2 * k], j = PairIJ[2 * k + 1];
	if (BondTrig[i] == 0u && BondTrig[j] == 0u) { return; }
	const float4 Pi = PosRW[i], Pj = PosRW[j];
	if (Pi.w <= 0.f && Pj.w <= 0.f) { return; }   // 고정끼리 (또는 무덤)
	if (IsGrave(Pi.xyz) || IsGrave(Pj.xyz)) { return; }
	const float Dist = distance(Pi.xyz, Pj.xyz);
	if (Dist >= FormRange) { return; }
	const float Wi = WetRO[i], Wj = WetRO[j];
	if (Wi <= WDry || Wj <= WDry) { return; }
	const float Coh = CohesionOfW(0.5f * (Wi + Wj));
	if (Coh <= 0.f) { return; }
	if (HasBond(i, j)) { return; }
	uint D0;
	if (!TakeSlot(i)) { InterlockedAdd(BondTotalRW[2], 1u, D0); return; }
	if (!TakeSlot(j)) { InterlockedAdd(BondSlotRW[i], 0xFFFFFFFFu, D0); InterlockedAdd(BondTotalRW[2], 1u, D0); return; }
	uint b;
	InterlockedAdd(BondTotalRW[0], 1u, b);
	if (b >= BondCap)
	{
		InterlockedAdd(BondTotalRW[0], 0xFFFFFFFFu, D0);
		InterlockedAdd(BondSlotRW[i], 0xFFFFFFFFu, D0);
		InterlockedAdd(BondSlotRW[j], 0xFFFFFFFFu, D0);
		InterlockedAdd(BondTotalRW[2], 1u, D0);
		return;
	}
	BondIJRW[2 * b] = i;
	BondIJRW[2 * b + 1] = j;
	// 휴지 길이 하한 = D (FormBonds 와 같다 — 침투한 쌍을 D 아래로 당기지 않게)
	BondDataRW[b] = float4(max(Dist, FormMinRest), 0.f, Coh, 0.f);
	InterlockedAdd(BondTotalRW[1], 1u, D0);
}

[numthreads(64, 1, 1)]
void BondFillCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint b = Tid.x;
	if (b >= min(BondTotalRW[0], BondCap)) { return; }
	if (BondDataRW[b].x < 0.f) { return; }
	const uint i = BondIJRW[2 * b], j = BondIJRW[2 * b + 1];
	uint Ci, Cj;
	InterlockedAdd(BondCursorRW[i], 1u, Ci);
	InterlockedAdd(BondCursorRW[j], 1u, Cj);
	BondAdjRW[BondAdjOffsetRO[i] + Ci] = (b << 1);
	BondAdjRW[BondAdjOffsetRO[j] + Cj] = (b << 1) | 1u;
}

