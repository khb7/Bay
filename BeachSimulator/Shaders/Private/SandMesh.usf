// M1 GPU 메시화 (m1-plan-gpu.md) — 입자 → 메시를 컴퓨트로. CPU 판(FSandSurfaceBuilder, SandSurface.cpp)과 단계마다 1:1.
//
// G1-3 띠 · 장: MarkBandCS → Scan(영역 커널 수) ← KCountCS → KFillCS → FieldCS (영역 = 그룹, 목록 정렬 후 모으기)
// G1-4 Surface Nets: VertCountCS → Scan → VertWriteCS → FaceCountCS → Scan → FaceWriteCS → MeshArgsCS
//
// G1-2 커널 · k_s · 등위값: MaxCountCS → EigenCS(+ 내부 σ1 부분합) → FinalizeKsCS → KernelCS → 커널 격자(x̄, 셀 = 지지) → IsoSampleCS → FinalizeIsoCS
//
// G1-1 이웃:
//   CellKeyCS        입자 → 셀 키(셀 = 이웃 반경 r_i) · 셀 안 순번(atomic)
//   Scan(CellCount)  → CellStart
//   ScatterCS        SortedIdx
//   NeighborStatsCS  입자별 27 칸: 이웃 수 · 치우침(C14) · 다듬은 중심 x̄ (Yu & Turk λ) · 가중 공분산

#include "/Engine/Public/Platform.ush"

#define SCAN_GROUP 1024
#define SAND_PI 3.1415926535897932f   // CPU 의 PI 와 같은 값          // 그룹당 2048 원소 (SandFrame.usf 와 같은 스캔)

uint  NumParticles;
uint  TableSize;                 // 셀 해시 표 크기 (2의 거듭제곱)
uint  ScanCount;
float NeighborR;                 // r_i — 셀 크기이기도 하다
float Lambda;                    // 중심 다듬기
float GridCell;                  // 지금 패스가 쓰는 격자의 셀 (이웃 격자 = r_i, 커널 격자 = 지지 반경)

// G1-2 커널 (CPU ③ · 등위값)
float H;
float Kr;
uint  NEps;
float Kn;
uint  KnRamp;
float KsFixed;                   // > 0 이면 그대로, 0 이면 내부 σ1 평균으로 자동
float MinSigma;
float MaxStretch;
float PVol;                      // 입자 부피 (4/3)πR³
float IsoFrac;
uint  SampleStep;                // 등위값 표본 간격 max(1, N/2000) — CPU 와 같은 규칙
uint  NumSamples;                // ceil(N / SampleStep)
uint  NumPartials;
float InteriorPhiFixed;          // > 0 이면 내부 φ 고정 (#19)

StructuredBuffer<float4>   PosRO;
StructuredBuffer<float4>   GridPosRO;        // 격자에 넣을 점 (이웃 격자 = 입자, 커널 격자 = x̄)

RWStructuredBuffer<uint>   CellKeyRW;
StructuredBuffer<uint>     CellKeyRO;
RWStructuredBuffer<uint>   CellSlotRW;
StructuredBuffer<uint>     CellSlotRO;
RWStructuredBuffer<uint>   CellCountRW;
StructuredBuffer<uint>     CellStart;        // TableSize + 1
RWStructuredBuffer<uint>   SortedIdxRW;
StructuredBuffer<uint>     SortedIdxRO;

RWStructuredBuffer<uint>   NCountRW;         // 이웃 수 (자기 제외)
RWStructuredBuffer<float>  DevRW;            // |Σ(x_j − x_i)| / (N · r_i)
RWStructuredBuffer<float4> SmoothedRW;       // x̄_i
RWStructuredBuffer<float4> CovARW;           // xx xy xz yy
RWStructuredBuffer<float4> CovBRW;           // yz zz

StructuredBuffer<uint>     NCountRO;
StructuredBuffer<float4>   SmoothedRO;
StructuredBuffer<float4>   CovARO;
StructuredBuffer<float4>   CovBRO;
RWStructuredBuffer<uint>   CountersRW;       // [0] 최대 이웃 수
StructuredBuffer<uint>     CountersRO;
RWStructuredBuffer<float4> EigValRW;         // σ1 ≥ σ2 ≥ σ3 (≥ 0)
StructuredBuffer<float4>   EigValRO;
RWStructuredBuffer<float4> EigVecRW;         // 입자당 3 개: 행 r = (R[r][0], R[r][1], R[r][2]) — 열 = 고유벡터
StructuredBuffer<float4>   EigVecRO;
RWStructuredBuffer<float2> PartialRW;        // 그룹별 (Σσ1, 수)
StructuredBuffer<float2>   PartialRO;
RWStructuredBuffer<float>  ScalarsRW;        // [0] k_s [1] 내부 φ [2] Iso [3] 내부 수 [4] 표본 수
StructuredBuffer<float>    ScalarsRO;
RWStructuredBuffer<float4> KernelRW;         // 입자당 4 개: (G0 G1 G2 DetG) (G3 G4 G5 0) (G6 G7 G8 0) (Ext 0)
StructuredBuffer<float4>   KernelRO;
RWStructuredBuffer<float2> SamplePhiRW;      // 표본별 (φ, 내부면 1)
StructuredBuffer<float2>   SamplePhiRO;

StructuredBuffer<uint>     ScanIn;
RWStructuredBuffer<uint>   ScanOut;          // ScanCount + 1 (마지막 = 총합)
RWStructuredBuffer<uint>   ScanSumsRW;
StructuredBuffer<uint>     ScanSumsRO;

// ------------------------------------------------------------------------------------------------
// 해시 — SandFrame.usf · CPU 와 같은 Teschner 2003

uint HashCell(int3 C, uint Table)
{
	const uint H = ((uint)(C.x * 73856093)) ^ ((uint)(C.y * 19349663)) ^ ((uint)(C.z * 83492791));
	return H & (Table - 1u);
}

int3 CellOf(float3 P, float Size)
{
	return int3(floor(P / Size));
}

// ------------------------------------------------------------------------------------------------
// 스캔 (배타 접두합) — SandFrame.usf 와 같은 3 패스. 2048 × 2048 = 4M 원소까지

groupshared uint ScanTemp[2 * SCAN_GROUP];

uint GroupScan(uint Tid, inout uint A, inout uint B)
{
	ScanTemp[2 * Tid]     = A;
	ScanTemp[2 * Tid + 1] = B;
	GroupMemoryBarrierWithGroupSync();
	for (uint Offset = 1; Offset < 2 * SCAN_GROUP; Offset <<= 1)
	{
		uint v0 = 0, v1 = 0;
		const uint i0 = 2 * Tid, i1 = 2 * Tid + 1;
		if (i0 >= Offset) { v0 = ScanTemp[i0 - Offset]; }
		if (i1 >= Offset) { v1 = ScanTemp[i1 - Offset]; }
		GroupMemoryBarrierWithGroupSync();
		ScanTemp[i0] += v0;
		ScanTemp[i1] += v1;
		GroupMemoryBarrierWithGroupSync();
	}
	const uint Total = ScanTemp[2 * SCAN_GROUP - 1];
	A = ScanTemp[2 * Tid] - A;
	B = ScanTemp[2 * Tid + 1] - B;
	return Total;
}

[numthreads(SCAN_GROUP, 1, 1)]
void ScanBlocksCS(uint3 GTid : SV_GroupThreadID, uint3 Gid : SV_GroupID)
{
	const uint Base = Gid.x * 2 * SCAN_GROUP + 2 * GTid.x;
	uint A = Base < ScanCount ? ScanIn[Base] : 0u;
	uint B = Base + 1 < ScanCount ? ScanIn[Base + 1] : 0u;
	const uint Total = GroupScan(GTid.x, A, B);
	if (Base < ScanCount)     { ScanOut[Base] = A; }
	if (Base + 1 < ScanCount) { ScanOut[Base + 1] = B; }
	if (GTid.x == 0) { ScanSumsRW[Gid.x] = Total; }
}

[numthreads(SCAN_GROUP, 1, 1)]
void ScanTopCS(uint3 GTid : SV_GroupThreadID)
{
	const uint NumGroups = (ScanCount + 2 * SCAN_GROUP - 1) / (2 * SCAN_GROUP);
	const uint Base = 2 * GTid.x;
	uint A = Base < NumGroups ? ScanSumsRW[Base] : 0u;
	uint B = Base + 1 < NumGroups ? ScanSumsRW[Base + 1] : 0u;
	const uint Total = GroupScan(GTid.x, A, B);
	if (Base < NumGroups)     { ScanSumsRW[Base] = A; }
	if (Base + 1 < NumGroups) { ScanSumsRW[Base + 1] = B; }
	if (GTid.x == 0) { ScanOut[ScanCount] = Total; }
}

[numthreads(SCAN_GROUP, 1, 1)]
void ScanAddCS(uint3 GTid : SV_GroupThreadID, uint3 Gid : SV_GroupID)
{
	const uint Add = ScanSumsRO[Gid.x];
	const uint Base = Gid.x * 2 * SCAN_GROUP + 2 * GTid.x;
	if (Base < ScanCount)     { ScanOut[Base] += Add; }
	if (Base + 1 < ScanCount) { ScanOut[Base + 1] += Add; }
}

// ------------------------------------------------------------------------------------------------
// G1-1 이웃

[numthreads(64, 1, 1)]
void CellKeyCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles) { return; }
	const uint Key = HashCell(CellOf(GridPosRO[i].xyz, GridCell), TableSize);
	CellKeyRW[i] = Key;
	uint Slot;
	InterlockedAdd(CellCountRW[Key], 1u, Slot);
	CellSlotRW[i] = Slot;
}

[numthreads(64, 1, 1)]
void ScatterCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles) { return; }
	SortedIdxRW[CellStart[CellKeyRO[i]] + CellSlotRO[i]] = i;
}

// 셀 안 순서를 입자 번호 순으로 — 순번이 원자 연산 순서라 실행마다 바뀌고, 그러면 이웃 합 순서가 바뀌어 비트가 달라진다 (G1-5 결정성).
// 셀당 입자가 적어(10cm 셀 ~8, 20cm 셀 ~60) 삽입 정렬로 충분
[numthreads(64, 1, 1)]
void SortCellsCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint k = Tid.x;
	if (k >= TableSize) { return; }
	const uint S0 = CellStart[k], S1 = CellStart[k + 1];
	for (uint a = S0 + 1; a < S1; ++a)
	{
		const uint V = SortedIdxRW[a];
		uint b = a;
		while (b > S0 && SortedIdxRW[b - 1] > V) { SortedIdxRW[b] = SortedIdxRW[b - 1]; --b; }
		SortedIdxRW[b] = V;
	}
}

// 27 칸 순회 (자기 포함). 지금 묶인 격자(GridCell · TableSize · CellStart · SortedIdxRO)를 돈다 — 해시 충돌로 같은 버킷을 두 번 도는 것만 막는다
#define FOR_NEIGHBORS_ALL(P, BODY) \
{ \
	const int3 C0 = CellOf(P, GridCell); \
	uint Keys[27]; uint NumKeys = 0; \
	for (int dz = -1; dz <= 1; ++dz) for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) \
	{ \
		const uint K = HashCell(C0 + int3(dx, dy, dz), TableSize); \
		bool bSeen = false; \
		for (uint q = 0; q < NumKeys; ++q) { if (Keys[q] == K) { bSeen = true; break; } } \
		if (!bSeen) { Keys[NumKeys++] = K; } \
	} \
	for (uint q = 0; q < NumKeys; ++q) \
	{ \
		const uint End = CellStart[Keys[q] + 1]; \
		for (uint s = CellStart[Keys[q]]; s < End; ++s) \
		{ \
			const uint j = SortedIdxRO[s]; \
			BODY \
		} \
	} \
}

// CPU ① 과 같다: W = 1 − (d/r)³, x̄ = (1−λ)x + λ Σ W x_j / Σ W, C = Σ W (x_j − x̄)(x_j − x̄)ᵀ / Σ W
[numthreads(64, 1, 1)]
void NeighborStatsCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles) { return; }
	const float3 Xi = PosRO[i].xyz;
	float Ws = 0.f; float3 Mean = 0.f; float3 Off = 0.f; uint Cnt = 0;
	FOR_NEIGHBORS_ALL(Xi,
	{
		const float3 Xj = PosRO[j].xyz;
		const float D = length(Xj - Xi);
		if (D < NeighborR)
		{
			const float Q = D / NeighborR;
			const float W = 1.f - Q * Q * Q;
			Ws += W; Mean += W * (Xj - Xi); Off += Xj - Xi; ++Cnt;   // 평균은 x_i 기준 상대 좌표로 (float 정밀도)
		}
	})
	NCountRW[i] = Cnt - 1;
	DevRW[i] = Cnt > 1 ? length(Off) / ((float)(Cnt - 1) * NeighborR) : 1.f;
	if (Ws <= 0.f)
	{
		SmoothedRW[i] = float4(Xi, 0.f); CovARW[i] = 0.f; CovBRW[i] = 0.f;
		return;
	}
	Mean /= Ws;   // x_i 기준
	SmoothedRW[i] = float4(Xi + Lambda * Mean, 0.f);
	float A0 = 0.f, A1 = 0.f, A2 = 0.f, A3 = 0.f, A4 = 0.f, A5 = 0.f;   // 매크로의 C0 와 겹치지 않게
	FOR_NEIGHBORS_ALL(Xi,
	{
		const float3 Xj = PosRO[j].xyz;
		const float D = length(Xj - Xi);
		if (D < NeighborR)
		{
			const float Q = D / NeighborR;
			const float W = 1.f - Q * Q * Q;
			const float3 R = (Xj - Xi) - Mean;
			A0 += W * R.x * R.x; A1 += W * R.x * R.y; A2 += W * R.x * R.z;
			A3 += W * R.y * R.y; A4 += W * R.y * R.z; A5 += W * R.z * R.z;
		}
	})
	CovARW[i] = float4(A0, A1, A2, A3) / Ws;
	CovBRW[i] = float4(A4, A5, 0.f, 0.f) / Ws;
}

// ------------------------------------------------------------------------------------------------
// G1-2 커널 (CPU ③) · k_s · 등위값

bool IsInteriorP(uint Cnt, uint MaxCount)
{
	const uint InteriorMin = max(NEps + 1u, (uint)(0.85f * (float)MaxCount));
	return MaxCount > NEps && Cnt >= InteriorMin;
}

[numthreads(64, 1, 1)]
void MaxCountCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles) { return; }
	InterlockedMax(CountersRW[0], NCountRO[i]);
}

// 대칭 3×3 야코비 — CPU Eigen3 과 같은 순서 · 같은 문턱
void Eigen3(inout float A[3][3], out float OutVal[3], out float OutVec[3][3])
{
	float V[3][3] = { {1,0,0},{0,1,0},{0,0,1} };
	for (int Sweep = 0; Sweep < 12; ++Sweep)
	{
		const float OffD = abs(A[0][1]) + abs(A[0][2]) + abs(A[1][2]);
		if (OffD < 1e-12f) { break; }
		for (int p = 0; p < 2; ++p)
		for (int q = p + 1; q < 3; ++q)
		{
			if (abs(A[p][q]) < 1e-14f) { continue; }
			const float Theta = (A[q][q] - A[p][p]) / (2.f * A[p][q]);
			const float T = (Theta >= 0.f ? 1.f : -1.f) / (abs(Theta) + sqrt(Theta * Theta + 1.f));
			const float C = 1.f / sqrt(T * T + 1.f), S = T * C;
			for (int k = 0; k < 3; ++k) { const float Akp = A[k][p], Akq = A[k][q]; A[k][p] = C * Akp - S * Akq; A[k][q] = S * Akp + C * Akq; }
			for (int k2 = 0; k2 < 3; ++k2) { const float Apk = A[p][k2], Aqk = A[q][k2]; A[p][k2] = C * Apk - S * Aqk; A[q][k2] = S * Apk + C * Aqk; }
			for (int k3 = 0; k3 < 3; ++k3) { const float Vkp = V[k3][p], Vkq = V[k3][q]; V[k3][p] = C * Vkp - S * Vkq; V[k3][q] = S * Vkp + C * Vkq; }
		}
	}
	int Ord[3] = { 0, 1, 2 };
	if (A[Ord[0]][Ord[0]] < A[Ord[1]][Ord[1]]) { const int t = Ord[0]; Ord[0] = Ord[1]; Ord[1] = t; }
	if (A[Ord[1]][Ord[1]] < A[Ord[2]][Ord[2]]) { const int t = Ord[1]; Ord[1] = Ord[2]; Ord[2] = t; }
	if (A[Ord[0]][Ord[0]] < A[Ord[1]][Ord[1]]) { const int t = Ord[0]; Ord[0] = Ord[1]; Ord[1] = t; }
	for (int k4 = 0; k4 < 3; ++k4)
	{
		OutVal[k4] = A[Ord[k4]][Ord[k4]];
		for (int r = 0; r < 3; ++r) { OutVec[r][k4] = V[r][Ord[k4]]; }
	}
}

groupshared float2 KsShared[64];

// 고유분해 + 그룹별 내부 σ1 부분합 (k_s 자동값)
[numthreads(64, 1, 1)]
void EigenCS(uint3 Tid : SV_DispatchThreadID, uint3 GTid : SV_GroupThreadID, uint3 Gid : SV_GroupID)
{
	const uint i = Tid.x;
	float2 Part = 0.f;
	if (i < NumParticles)
	{
		const float4 Ca = CovARO[i], Cb = CovBRO[i];
		float A[3][3] = { { Ca.x, Ca.y, Ca.z }, { Ca.y, Ca.w, Cb.x }, { Ca.z, Cb.x, Cb.y } };
		float L[3], R[3][3];
		Eigen3(A, L, R);
		const float3 Lv = max(float3(L[0], L[1], L[2]), 0.f);
		EigValRW[i] = float4(Lv, 0.f);
		for (int r = 0; r < 3; ++r) { EigVecRW[i * 3 + r] = float4(R[r][0], R[r][1], R[r][2], 0.f); }
		if (IsInteriorP(NCountRO[i], CountersRO[0]) && Lv.x > 0.f) { Part = float2(Lv.x, 1.f); }
	}
	KsShared[GTid.x] = Part;
	GroupMemoryBarrierWithGroupSync();
	for (uint Sz = 32; Sz > 0; Sz >>= 1)
	{
		if (GTid.x < Sz) { KsShared[GTid.x] += KsShared[GTid.x + Sz]; }
		GroupMemoryBarrierWithGroupSync();
	}
	if (GTid.x == 0) { PartialRW[Gid.x] = KsShared[0]; }
}

[numthreads(1, 1, 1)]
void FinalizeKsCS()
{
	float Sum = 0.f, Cnt = 0.f;
	for (uint g = 0; g < NumPartials; ++g) { Sum += PartialRO[g].x; Cnt += PartialRO[g].y; }
	// 내부가 없으면 이론값 1/(0.15 r²) — CPU 와 같다
	ScalarsRW[0] = KsFixed > 0.f ? KsFixed : (Cnt > 0.f ? Cnt / Sum : 1.f / (0.15f * NeighborR * NeighborR));
	ScalarsRW[3] = Cnt;
}

// 커널 G = (1/h) R Σ̃⁻¹ Rᵀ · DetG · 지지 반폭 Ext (CPU ③ 이방성)
[numthreads(64, 1, 1)]
void KernelCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles) { return; }
	const float Ks = ScalarsRO[0];
	const float3 Lv = EigValRO[i].xyz;
	const uint Cnt = NCountRO[i];
	float S[3];
	if (Cnt > NEps)
	{
		S[0] = Ks * Lv.x;
		S[1] = Ks * max(Lv.y, Lv.x / Kr);
		S[2] = Ks * max(Lv.z, Lv.x / Kr);
	}
	else
	{
		const float KnN = KnRamp > 0u ? Kn + (1.f - Kn) * min(1.f, (float)Cnt / (float)KnRamp) : Kn;
		S[0] = KnN; S[1] = KnN; S[2] = KnN;
	}
	for (int k = 0; k < 3; ++k) { S[k] = clamp(S[k], max(1e-3f, MinSigma), MaxStretch); }
	float R[3][3];
	for (int r = 0; r < 3; ++r) { const float4 Row = EigVecRO[i * 3 + r]; R[r][0] = Row.x; R[r][1] = Row.y; R[r][2] = Row.z; }
	float G[9];
	for (int r2 = 0; r2 < 3; ++r2)
	for (int c = 0; c < 3; ++c)
	{
		float V = 0.f;
		for (int k2 = 0; k2 < 3; ++k2) { V += R[r2][k2] * (1.f / S[k2]) * R[c][k2]; }
		G[r2 * 3 + c] = V / H;
	}
	const float DetG = 1.f / (H * H * H * S[0] * S[1] * S[2]);
	float3 Ext;
	for (int a = 0; a < 3; ++a)
	{
		float S2 = 0.f;
		for (int c2 = 0; c2 < 3; ++c2)
		{
			float V2 = 0.f;
			for (int k3 = 0; k3 < 3; ++k3) { V2 += R[a][k3] * S[k3] * R[c2][k3]; }
			S2 += (V2 * H) * (V2 * H);
		}
		Ext[a] = 2.f * sqrt(S2);
	}
	KernelRW[i * 4 + 0] = float4(G[0], G[1], G[2], DetG);
	KernelRW[i * 4 + 1] = float4(G[3], G[4], G[5], 0.f);
	KernelRW[i * 4 + 2] = float4(G[6], G[7], G[8], 0.f);
	KernelRW[i * 4 + 3] = float4(Ext, 0.f);
}

// B-cubic (Yu & Turk), 지지 q < 2, 3D 정규화 1/π
float BCubic(float Q)
{
	if (Q >= 2.f) { return 0.f; }
	if (Q < 1.f) { return (1.f / SAND_PI) * (1.f - 1.5f * Q * Q + 0.75f * Q * Q * Q); }
	const float T = 2.f - Q;
	return (1.f / SAND_PI) * 0.25f * T * T * T;
}



// 등위값 표본: 그룹 하나 = 후보 k 하나 (입자 k·SampleStep), 스레드 하나 = 이웃 격자 칸 하나 (±3 → 7³ = 343).
// 커널 중심 x̄ 는 x 에서 λ·r_i(9cm) 안이라 지지 20cm + 9cm 를 덮는다 (#18 — 커널 격자 · 셀 정렬 제거).
// 해시 충돌로 같은 버킷을 두 번 돌 수 있어 "입자의 실제 셀 = 이 칸" 을 확인한다. 합은 고정 트리 순서 (결정적)
groupshared float IsoShared[343];

[numthreads(7, 7, 7)]
void IsoSampleCS(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint GI : SV_GroupIndex)
{
	const uint k = Gid.x;
	const uint i = k * SampleStep;
	const bool bValid = k < NumSamples && i < NumParticles && IsInteriorP(NCountRO[min(i, NumParticles - 1)], CountersRO[0]);
	float Phi = 0.f;
	if (bValid)
	{
		const float3 X = PosRO[i].xyz;
		const int3 Cc = CellOf(X, GridCell) + int3(GTid) - 3;
		const uint Key = HashCell(Cc, TableSize);
		const uint End = CellStart[Key + 1];
		for (uint s = CellStart[Key]; s < End; ++s)
		{
			const uint j = SortedIdxRO[s];
			if (any(CellOf(PosRO[j].xyz, GridCell) != Cc)) { continue; }
			const float4 K0 = KernelRO[j * 4 + 0];
			const float4 K1 = KernelRO[j * 4 + 1];
			const float4 K2 = KernelRO[j * 4 + 2];
			const float3 R = X - SmoothedRO[j].xyz;
			const float3 GR = float3(dot(K0.xyz, R), dot(K1.xyz, R), dot(K2.xyz, R));
			Phi += PVol * K0.w * BCubic(length(GR));
		}
	}
	IsoShared[GI] = Phi;
	GroupMemoryBarrierWithGroupSync();
	for (uint Sz = 256; Sz > 0; Sz >>= 1)
	{
		if (GI < Sz && GI + Sz < 343) { IsoShared[GI] += IsoShared[GI + Sz]; }
		GroupMemoryBarrierWithGroupSync();
	}
	if (GI == 0 && k < NumSamples) { SamplePhiRW[k] = float2(IsoShared[0], bValid ? 1.f : 0.f); }
}

[numthreads(1, 1, 1)]
void FinalizeIsoCS()
{
	if (InteriorPhiFixed > 0.f) { ScalarsRW[1] = InteriorPhiFixed; ScalarsRW[2] = InteriorPhiFixed * IsoFrac; ScalarsRW[4] = 0.f; return; }
	float Sum = 0.f; uint Cnt = 0;
	for (uint k = 0; k < NumSamples && Cnt < 512u; ++k)
	{
		const float2 V = SamplePhiRO[k];
		if (V.y > 0.f) { Sum += V.x; ++Cnt; }
	}
	// 내부가 없으면(얇은 벽 · 부스러기) 고체 분율 기준값 0.6 — CPU 와 같다
	const float InteriorPhi = Cnt > 0u ? Sum / (float)Cnt : 0.6f;
	ScalarsRW[1] = InteriorPhi;
	ScalarsRW[2] = InteriorPhi * IsoFrac;
	ScalarsRW[4] = (float)Cnt;
}

// ------------------------------------------------------------------------------------------------
// G1-3 띠 · 활성 영역 · 장 φ   /   G1-4 Surface Nets
//
// 격자 = CPU 와 같은 원점 GOrigin · 크기 GD (점). 영역 = 8³ 점 (스레드 그룹 하나). 영역은 조밀 배열로 다 띄우고
// 띠 없는 영역은 그룹이 바로 끝난다 (영역 수가 수천이라 간접 디스패치 없이도 싸다).
// Band · F · CellVert 는 격자 전체 조밀 배열 — 시험 장면 크기에선 충분하다 (G3 에서 타일 단위로 줄인다).

#define MB 8                     // 영역 한 변 (점)
#define MB3 (MB * MB * MB)
#define KLIST_MAX 2048           // 영역당 커널 목록 — 넘치면 정렬 없이 순서대로 (결정성만 잃는다, 계수 기록)
#define INVALID_V 0xFFFFFFFFu

float3 GOrigin;
uint3  GD;                       // 격자 점 수
uint3  BD;                       // 영역 수
float  Cell;
float  BandReach;                // 띠 반경 (표면 입자에서)
uint   BandNEps;
float  SurfDev;
uint   MaxPairsK;                // 영역·커널 쌍 용량
uint   MaxVerts;
uint   MaxIndices;

StructuredBuffer<float>    DevRO;
// 띠 · 장 · 셀 정점은 활성 영역 슬롯에만 (#23 — 격자 전체 조밀 배열은 고정 영역에서 수십 MB)
//   점 P 의 자리 = BlockSlot[영역(P)] × 512 + 영역 안 색인. 슬롯이 없으면(띠 없는 영역) 띠 아님 · 장 −1
RWStructuredBuffer<uint>   BlockSlotRW;      // 영역별 슬롯 (없으면 INVALID_V)
StructuredBuffer<uint>     BlockSlotRO;
StructuredBuffer<uint>     BlockSlotStart;   // BlockActive 접두합
uint  MaxSlots;
RWStructuredBuffer<uint>   BandRW;           // 슬롯 점별 0/1
StructuredBuffer<uint>     BandRO;
RWStructuredBuffer<uint>   BlockActiveRW;    // 영역별 0/1
StructuredBuffer<uint>     BlockActiveRO;
RWStructuredBuffer<uint>   BlockKCountRW;    // 영역별 커널 수
StructuredBuffer<uint>     BlockKStart;      // + 1
RWStructuredBuffer<uint>   BlockKCursorRW;
RWStructuredBuffer<uint>   BlockKItemsRW;
StructuredBuffer<uint>     BlockKItemsRO;
RWStructuredBuffer<float>  FieldRW;          // φ − Iso, 띠 밖 −1
StructuredBuffer<float>    FieldRO;
RWStructuredBuffer<uint>   BlockVCountRW;    // 영역별 정점 수
StructuredBuffer<uint>     BlockVStart;
RWStructuredBuffer<uint>   BlockTCountRW;    // 영역별 색인 수
StructuredBuffer<uint>     BlockTStart;
RWStructuredBuffer<uint>   CellVertRW;       // 띠 점 = 그 점을 꼭짓점 0 으로 하는 셀의 정점 번호 (없으면 INVALID_V)
StructuredBuffer<uint>     CellVertRO;
RWStructuredBuffer<float4> VertexRW;         // xyz 위치
RWStructuredBuffer<float4> NormalRW;
RWStructuredBuffer<uint>   IndexRW;
RWBuffer<uint>             DrawArgsRW;       // {색인 수, 1, 0, 0, 0} — G2 간접 그리기
// G2 화면 출력 — FLocalVertexFactory 가 그대로 읽는 형식 (bRenderOut 일 때만)
uint  bRenderOut;
// 가중 라플라시안 평활화 (papers C13 · CPU SandSurface.cpp 와 같은 규칙)
uint  SmoothIters;
float SmoothNorm;
RWStructuredBuffer<float>  WnnRW;            // 입자별 Σ(1 − d²/r²)
StructuredBuffer<float>    WnnRO;
RWStructuredBuffer<uint>   VertPtRW;         // 정점 → 셀 꼭짓점 0 의 점 색인
StructuredBuffer<uint>     VertPtRO;
RWStructuredBuffer<float>  VertWRW;          // 정점 가중 w
StructuredBuffer<float>    VertWRO;
RWStructuredBuffer<int>    VertNbRW;         // 정점당 6 이웃 (−1 없음)
StructuredBuffer<int>      VertNbRO;
StructuredBuffer<float4>   SmoothSrc;
RWStructuredBuffer<float4> SmoothDst;
RWBuffer<float>            RPosRW;           // 정점당 3 (float3 스트림)
RWBuffer<uint>             RTanRW;           // 정점당 2: TangentX · TangentZ (FPackedNormal, 부호 있는 8 비트 × 4)
RWBuffer<uint>             RIdxRW;           // 32 비트 색인 버퍼
// 입자별 W → 정점 색 (M1 W2, m1-plan-wet.md)
uint  bHasWet;
StructuredBuffer<float>    WetRO;            // 입자별 W
RWBuffer<uint>             RColRW;           // 정점당 RGBA8 — R = G = B = W (스위즐 무관), A = 255
// CountersRW: [0] 최대 이웃 수 [1] 커널 목록 넘침 영역 [2] 쌍 용량 넘침 [3] 정점 총수 [4] 색인 총수 [5] 슬롯 넘침 영역

uint PtIndex(uint3 P) { return (P.z * GD.y + P.y) * GD.x + P.x; }
uint BlockIndex(uint3 B) { return (B.z * BD.y + B.y) * BD.x + B.x; }
float3 PtPos(uint3 P) { return GOrigin + float3(P) * Cell; }

uint SlotPt(uint3 P)
{
	const uint Sl = BlockSlotRO[BlockIndex(P / MB)];
	if (Sl == INVALID_V) { return INVALID_V; }
	const uint3 L = P % MB;
	return Sl * MB3 + (L.z * MB + L.y) * MB + L.x;
}
bool BandAt(uint3 P) { const uint I = SlotPt(P); return I != INVALID_V && BandRO[I] != 0u; }
float FieldAt(uint3 P) { const uint I = SlotPt(P); return I == INVALID_V ? -1.f : FieldRO[I]; }

bool IsSurfP(uint i) { return NCountRO[i] < BandNEps || (SurfDev > 0.f && DevRO[i] > SurfDev); }

// 표면 입자 → 띠 점 (CPU ④ 와 같은 줄 구간 식). 두 번 돈다: ① 영역 활성만 → 슬롯 배정 → ② 슬롯에 띠 점
void MarkSphere(uint i, bool bBlocksOnly)
{
	const float3 X = PosRO[i].xyz;
	const float3 L = (X - GOrigin) / Cell;
	const int3 Cc = int3(floor(L + 0.5f));   // CPU RoundToInt 과 같다
	const int RC = (int)ceil(BandReach / Cell);
	for (int z = max(0, Cc.z - RC); z <= min((int)GD.z - 1, Cc.z + RC); ++z)
	for (int y = max(0, Cc.y - RC); y <= min((int)GD.y - 1, Cc.y + RC); ++y)
	{
		const float Dy = GOrigin.y + y * Cell - X.y, Dz = GOrigin.z + z * Cell - X.z;
		const float R2 = BandReach * BandReach - Dy * Dy - Dz * Dz;
		if (R2 < 0.f) { continue; }
		const float Hx = sqrt(R2) / Cell;
		const int x0 = max(0, (int)ceil(L.x - Hx)), x1 = min((int)GD.x - 1, (int)floor(L.x + Hx));
		for (int x = x0; x <= x1; ++x)
		{
			const uint3 P = uint3(x, y, z);
			if (bBlocksOnly) { BlockActiveRW[BlockIndex(P / MB)] = 1u; }   // 같은 값 쓰기라 경쟁 무해
			else { const uint I = SlotPt(P); if (I != INVALID_V) { BandRW[I] = 1u; } }
		}
	}
}

[numthreads(64, 1, 1)]
void MarkBlocksCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles || !IsSurfP(i)) { return; }
	MarkSphere(i, true);
}

[numthreads(64, 1, 1)]
void MarkBandCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles || !IsSurfP(i)) { return; }
	MarkSphere(i, false);
}

// 활성 영역 → 슬롯 (접두합 순 = 영역 번호 순, 결정적). 넘치면 그 영역은 버린다 (계수 [5])
[numthreads(64, 1, 1)]
void SlotAssignCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint b = Tid.x;
	if (b >= BD.x * BD.y * BD.z) { return; }
	uint Sl = INVALID_V;
	if (BlockActiveRO[b])
	{
		if (BlockSlotStart[b] < MaxSlots) { Sl = BlockSlotStart[b]; }
		else { InterlockedAdd(CountersRW[5], 1u); }
	}
	BlockSlotRW[b] = Sl;
}

// 커널 지지 AABB 의 점 범위 (CPU PtRange 와 같다)
bool KernelPtRange(uint j, out int3 Lo, out int3 Hi)
{
	const float3 C = SmoothedRO[j].xyz;
	const float3 Ext = KernelRO[j * 4 + 3].xyz;
	const float3 A = (C - Ext - GOrigin) / Cell, B = (C + Ext - GOrigin) / Cell;
	Lo = max(int3(0, 0, 0), int3(ceil(A)));
	Hi = min(int3(GD) - 1, int3(floor(B)));
	return all(Lo <= Hi);
}

[numthreads(64, 1, 1)]
void KCountCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint j = Tid.x;
	if (j >= NumParticles) { return; }
	int3 Lo, Hi;
	if (!KernelPtRange(j, Lo, Hi)) { return; }
	const int3 B0 = Lo / MB, B1 = Hi / MB;
	for (int bz = B0.z; bz <= B1.z; ++bz) for (int by = B0.y; by <= B1.y; ++by) for (int bx = B0.x; bx <= B1.x; ++bx)
	{
		const uint b = BlockIndex(uint3(bx, by, bz));
		if (BlockActiveRO[b]) { InterlockedAdd(BlockKCountRW[b], 1u); }
	}
}

[numthreads(64, 1, 1)]
void KFillCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint j = Tid.x;
	if (j >= NumParticles) { return; }
	int3 Lo, Hi;
	if (!KernelPtRange(j, Lo, Hi)) { return; }
	const int3 B0 = Lo / MB, B1 = Hi / MB;
	for (int bz = B0.z; bz <= B1.z; ++bz) for (int by = B0.y; by <= B1.y; ++by) for (int bx = B0.x; bx <= B1.x; ++bx)
	{
		const uint b = BlockIndex(uint3(bx, by, bz));
		if (!BlockActiveRO[b]) { continue; }
		uint Slot;
		InterlockedAdd(BlockKCursorRW[b], 1u, Slot);
		const uint At = BlockKStart[b] + Slot;
		if (At < MaxPairsK) { BlockKItemsRW[At] = j; } else { InterlockedAdd(CountersRW[2], 1u); }
	}
}

groupshared uint KList[KLIST_MAX];

// 영역 하나 = 그룹 하나 (8³ 스레드, 점 하나씩). 영역 커널 목록을 공유 메모리에 올려 입자 번호 순으로 정렬(결정성) 후 점마다 모은다
[numthreads(MB, MB, MB)]
void FieldCS(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint GI : SV_GroupIndex)
{
	const uint b = BlockIndex(Gid);
	if (!BlockActiveRO[b]) { return; }
	const uint S0 = BlockKStart[b];
	const uint Cnt = min(BlockKStart[b + 1] - S0, MaxPairsK > S0 ? MaxPairsK - S0 : 0u);
	const bool bSorted = Cnt <= KLIST_MAX;
	if (bSorted)
	{
		// 2 의 거듭제곱으로 채워 바이토닉 정렬
		uint Pow2 = 1; while (Pow2 < Cnt) { Pow2 <<= 1; }
		for (uint k = GI; k < Pow2; k += MB3) { KList[k] = k < Cnt ? BlockKItemsRO[S0 + k] : 0xFFFFFFFFu; }
		GroupMemoryBarrierWithGroupSync();
		for (uint Size = 2; Size <= Pow2; Size <<= 1)
		for (uint Stride = Size >> 1; Stride > 0; Stride >>= 1)
		{
			for (uint t = GI; t < Pow2; t += MB3)
			{
				const uint Partner = t ^ Stride;
				if (Partner > t)
				{
					const bool bAsc = (t & Size) == 0;
					const uint A = KList[t], Bv = KList[Partner];
					if ((A > Bv) == bAsc) { KList[t] = Bv; KList[Partner] = A; }
				}
			}
			GroupMemoryBarrierWithGroupSync();
		}
	}
	else if (GI == 0) { InterlockedAdd(CountersRW[1], 1u); }

	const uint3 P = Gid * MB + GTid;
	if (any(P >= GD)) { return; }
	const uint I = SlotPt(P);
	if (I == INVALID_V || !BandRO[I]) { return; }
	const float3 X = PtPos(P);
	float Phi = 0.f;
	for (uint k = 0; k < Cnt; ++k)
	{
		const uint j = bSorted ? KList[k] : BlockKItemsRO[S0 + k];
		const float4 K0 = KernelRO[j * 4 + 0];
		const float4 K1 = KernelRO[j * 4 + 1];
		const float4 K2 = KernelRO[j * 4 + 2];
		const float3 R = X - SmoothedRO[j].xyz;
		const float3 GR = float3(dot(K0.xyz, R), dot(K1.xyz, R), dot(K2.xyz, R));
		const float Q2 = dot(GR, GR);
		if (Q2 < 4.f) { Phi += PVol * K0.w * BCubic(sqrt(Q2)); }
	}
	FieldRW[I] = Phi - ScalarsRO[2];
}

// ---- G1-4 Surface Nets (CPU ⑥ 과 같은 셀 · 정점 · 법선 · 면 규칙) ----

static const uint3 CornerOf[8] = { uint3(0,0,0), uint3(1,0,0), uint3(0,1,0), uint3(1,1,0), uint3(0,0,1), uint3(1,0,1), uint3(0,1,1), uint3(1,1,1) };
static const uint2 EdgeOf[12] = { uint2(0,1), uint2(2,3), uint2(4,5), uint2(6,7), uint2(0,2), uint2(1,3), uint2(4,6), uint2(5,7), uint2(0,4), uint2(1,5), uint2(2,6), uint2(3,7) };

// 점 P 를 꼭짓점 0 으로 하는 셀에 정점이 있나 (8 꼭짓점 모두 띠 · 부호가 섞임). 있으면 위치
bool CellVertex(uint3 P, out float3 OutPos)
{
	OutPos = 0.f;
	if (any(P + 1 >= GD)) { return false; }
	float V[8]; uint Mask = 0;
	for (uint c = 0; c < 8; ++c)
	{
		const uint3 Pc = P + CornerOf[c];
		if (!BandAt(Pc)) { return false; }
		V[c] = FieldAt(Pc);
		Mask |= (V[c] > 0.f) ? (1u << c) : 0u;
	}
	if (Mask == 0u || Mask == 0xFFu) { return false; }
	float3 Acc = 0.f; float N = 0.f;
	for (uint e = 0; e < 12; ++e)
	{
		const uint A = EdgeOf[e].x, B = EdgeOf[e].y;
		if ((V[A] > 0.f) == (V[B] > 0.f)) { continue; }
		const float T = V[A] / (V[A] - V[B]);
		Acc += float3(CornerOf[A]) + (float3(CornerOf[B]) - float3(CornerOf[A])) * T; N += 1.f;
	}
	OutPos = GOrigin + (float3(P) + Acc / N) * Cell;
	return true;
}

// FPackedNormal (int8 × 4, x 가 낮은 바이트)
uint PackSNorm8(float4 V)
{
	const int4 Q = int4(round(clamp(V, -1.f, 1.f) * 127.f));
	return (uint(Q.x) & 0xFFu) | ((uint(Q.y) & 0xFFu) << 8) | ((uint(Q.z) & 0xFFu) << 16) | ((uint(Q.w) & 0xFFu) << 24);
}

float Fat(int3 P)
{
	P = clamp(P, int3(0, 0, 0), int3(GD) - 1);
	return FieldAt(uint3(P));
}

groupshared uint GsScan[MB3];

// 그룹 안 배타 접두합 (512) — 돌려주는 값은 그룹 총합
uint GroupPrefix(uint GI, inout uint V)
{
	GsScan[GI] = V;
	GroupMemoryBarrierWithGroupSync();
	for (uint Off = 1; Off < MB3; Off <<= 1)
	{
		const uint Add = GI >= Off ? GsScan[GI - Off] : 0u;
		GroupMemoryBarrierWithGroupSync();
		GsScan[GI] += Add;
		GroupMemoryBarrierWithGroupSync();
	}
	const uint Total = GsScan[MB3 - 1];
	V = GsScan[GI] - V;
	return Total;
}

// 영역 안 점 순서 = 스레드 순서(GI) → 정점 · 면 번호가 실행마다 같다
[numthreads(MB, MB, MB)]
void VertCountCS(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint GI : SV_GroupIndex)
{
	const uint b = BlockIndex(Gid);
	if (!BlockActiveRO[b]) { if (GI == 0) { BlockVCountRW[b] = 0u; } return; }
	const uint3 P = Gid * MB + GTid;
	float3 Vp;
	uint Has = (all(P < GD) && BandAt(P) && CellVertex(P, Vp)) ? 1u : 0u;
	const uint Total = GroupPrefix(GI, Has);
	if (GI == 0) { BlockVCountRW[b] = Total; }
}

[numthreads(MB, MB, MB)]
void VertWriteCS(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint GI : SV_GroupIndex)
{
	const uint b = BlockIndex(Gid);
	if (!BlockActiveRO[b]) { return; }
	const uint3 P = Gid * MB + GTid;
	const bool bIn = all(P < GD) && BandAt(P);
	float3 Vp;
	const bool bHas = bIn && CellVertex(P, Vp);
	uint Local = bHas ? 1u : 0u;
	GroupPrefix(GI, Local);
	if (!bIn) { return; }
	const uint I = SlotPt(P);
	if (!bHas) { CellVertRW[I] = INVALID_V; return; }
	const uint Vi = BlockVStart[b] + Local;
	CellVertRW[I] = Vi;
	if (Vi >= MaxVerts) { return; }
	VertexRW[Vi] = float4(Vp, 0.f);
	VertPtRW[Vi] = PtIndex(P);   // 격자 좌표 부호 (배열 색인 아님)
	float3 G = 0.f;
	for (uint c = 0; c < 8; ++c)
	{
		const int3 Q = int3(P + CornerOf[c]);
		G += float3(Fat(Q + int3(1, 0, 0)) - Fat(Q - int3(1, 0, 0)), Fat(Q + int3(0, 1, 0)) - Fat(Q - int3(0, 1, 0)), Fat(Q + int3(0, 0, 1)) - Fat(Q - int3(0, 0, 1)));
	}
	const float L2 = dot(G, G);
	const float3 Nrm = L2 > 1e-16f ? -G * rsqrt(L2) : float3(0.f, 0.f, 1.f);
	NormalRW[Vi] = float4(L2 > 1e-16f ? Nrm : float3(0.f, 0.f, 0.f), 0.f);
}

uint VertAt(int3 C)
{
	if (any(C < 0) || any(C + 1 >= int3(GD))) { return INVALID_V; }
	const uint I = SlotPt(uint3(C));
	return (I != INVALID_V && BandRO[I]) ? CellVertRO[I] : INVALID_V;
}

// 점 P 에서 +축 모서리마다 사각형 (CPU 의 면 규칙). Out 이 있으면 색인을 쓴다
uint FaceQuads(uint3 P, bool bWrite, uint Base)
{
	if (any(P < 1) || any(P + 1 >= GD)) { return 0u; }
	if (!BandAt(P)) { return 0u; }
	const bool In0 = FieldAt(P) > 0.f;
	uint NumIdx = 0;
	for (uint Axis = 0; Axis < 3; ++Axis)
	{
		const uint3 P1 = P + uint3(Axis == 0, Axis == 1, Axis == 2);
		if (!BandAt(P1) || (FieldAt(P1) > 0.f) == In0) { continue; }
		uint Q[4]; bool bOk = true;
		for (uint k = 0; k < 4; ++k)
		{
			const int da = (k == 1 || k == 2) ? 1 : 0, db = (k >= 2) ? 1 : 0;
			int3 C = int3(P);
			if (Axis == 0) { C.y -= 1 - da; C.z -= 1 - db; }
			else if (Axis == 1) { C.z -= 1 - da; C.x -= 1 - db; }
			else { C.x -= 1 - da; C.y -= 1 - db; }
			Q[k] = VertAt(C);
			if (Q[k] == INVALID_V) { bOk = false; }
		}
		if (!bOk) { continue; }
		if (bWrite)
		{
			const uint At = Base + NumIdx;
			if (At + 6 <= MaxIndices)
			{
				uint Ix[6];
				if (In0) { Ix[0] = Q[0]; Ix[1] = Q[1]; Ix[2] = Q[2]; Ix[3] = Q[0]; Ix[4] = Q[2]; Ix[5] = Q[3]; }
				else     { Ix[0] = Q[0]; Ix[1] = Q[2]; Ix[2] = Q[1]; Ix[3] = Q[0]; Ix[4] = Q[3]; Ix[5] = Q[2]; }
				for (uint t = 0; t < 6; ++t)
				{
					IndexRW[At + t] = Ix[t];
					if (bRenderOut) { RIdxRW[At + t] = Ix[t]; }
				}
			}
		}
		NumIdx += 6;
	}
	return NumIdx;
}

[numthreads(MB, MB, MB)]
void FaceCountCS(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint GI : SV_GroupIndex)
{
	const uint b = BlockIndex(Gid);
	if (!BlockActiveRO[b]) { if (GI == 0) { BlockTCountRW[b] = 0u; } return; }
	const uint3 P = Gid * MB + GTid;
	uint N = all(P < GD) ? FaceQuads(P, false, 0u) : 0u;
	const uint Total = GroupPrefix(GI, N);
	if (GI == 0) { BlockTCountRW[b] = Total; }
}

[numthreads(MB, MB, MB)]
void FaceWriteCS(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint GI : SV_GroupIndex)
{
	const uint b = BlockIndex(Gid);
	if (!BlockActiveRO[b]) { return; }
	const uint3 P = Gid * MB + GTid;
	const bool bIn = all(P < GD);
	uint N = bIn ? FaceQuads(P, false, 0u) : 0u;
	GroupPrefix(GI, N);
	if (bIn) { FaceQuads(P, true, BlockTStart[b] + N); }
}

[numthreads(1, 1, 1)]
void MeshArgsCS()
{
	const uint NumBlocks = BD.x * BD.y * BD.z;
	const uint NumV = BlockVStart[NumBlocks];
	const uint NumI = BlockTStart[NumBlocks];
	CountersRW[3] = NumV;
	CountersRW[4] = NumI;
	DrawArgsRW[0] = min(NumI, MaxIndices - MaxIndices % 3u);   // 넘치면 잘린 만큼만 그린다
	DrawArgsRW[1] = 1u;
	DrawArgsRW[2] = 0u;
	DrawArgsRW[3] = 0u;
	DrawArgsRW[4] = 0u;
}

// G2 — 색인 꼬리를 퇴화 삼각형(0,0,0)으로. 화면 쪽은 간접 인자 대신 MaxIndices 를 고정 개수로 그린다:
// GPU 장면 인스턴스 컬링을 쓰는 패스(VSM 그림자 등)는 메시의 간접 인자를 자기 인자로 덮어써서(MeshPassProcessor.cpp) 0 개가 그려진다
[numthreads(64, 1, 1)]
void IndexTailCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= MaxIndices) { return; }
	const uint NumBlocks = BD.x * BD.y * BD.z;
	if (i >= BlockTStart[NumBlocks]) { RIdxRW[i] = 0u; }
}

// ---- 가중 라플라시안 평활화 (Löschner 2023 / splashsurf, papers C13) ----

// 입자 wnn — 이웃 격자 (셀 = r_i) 를 돈다
[numthreads(64, 1, 1)]
void WnnCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x;
	if (i >= NumParticles) { return; }
	const float3 Xi = PosRO[i].xyz;
	const float R2 = NeighborR * NeighborR;
	float S = 0.f;
	FOR_NEIGHBORS_ALL(Xi,
	{
		const float D2 = dot(PosRO[j].xyz - Xi, PosRO[j].xyz - Xi);
		if (D2 < R2) { S += 1.f - D2 / R2; }
	})
	WnnRW[i] = S;
}

// 정점 가중: 셰퍼드 보간 → smoothstep, 그리고 면을 맞댄 셀 6 개의 정점
[numthreads(64, 1, 1)]
void VertWeightCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint v = Tid.x;
	if (v >= min(CountersRO[3], MaxVerts)) { return; }
	const float3 X = SmoothSrc[v].xyz;   // 평활화 전 정점 (VertexB 를 SRV 로)
	const float R2 = NeighborR * NeighborR;
	float Sw = 0.f, Swn = 0.f;
	FOR_NEIGHBORS_ALL(X,
	{
		const float D2 = dot(PosRO[j].xyz - X, PosRO[j].xyz - X);
		if (D2 < R2) { const float T = 1.f - D2 / R2; const float K = T * T * T; Sw += K; Swn += K * WnnRO[j]; }
	})
	const float Xn = Sw > 0.f ? clamp(Swn / Sw / SmoothNorm, 0.f, 1.f) : 0.f;
	VertWRW[v] = Xn * Xn * Xn * (Xn * (Xn * 6.f - 15.f) + 10.f);
	const uint I = VertPtRO[v];
	const int3 P = int3(I % GD.x, (I / GD.x) % GD.y, I / (GD.x * GD.y));
	const int3 D6[6] = { int3(1,0,0), int3(-1,0,0), int3(0,1,0), int3(0,-1,0), int3(0,0,1), int3(0,0,-1) };
	for (uint k = 0; k < 6; ++k)
	{
		const uint U = VertAt(P + D6[k]);
		VertNbRW[v * 6 + k] = U == INVALID_V ? -1 : (int)U;
	}
}

StructuredBuffer<float4>   NormalSrc;
RWStructuredBuffer<float4> NormalDst;

// 한 번 반복: Dst = Src + w·(mean(이웃) − Src) — 위치와 법선을 한 패스에 (#24, 같은 가중 · 이웃)
[numthreads(64, 1, 1)]
void SmoothCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint v = Tid.x;
	if (v >= min(CountersRO[3], MaxVerts)) { return; }
	const float3 A = SmoothSrc[v].xyz;
	const float3 An = NormalSrc[v].xyz;
	float3 Sum = 0.f, SumN = 0.f; float Cnt = 0.f;
	for (uint k = 0; k < 6; ++k) { const int U = VertNbRO[v * 6 + k]; if (U >= 0) { Sum += SmoothSrc[U].xyz; SumN += NormalSrc[U].xyz; Cnt += 1.f; } }
	const float W = VertWRO[v];
	SmoothDst[v] = float4(Cnt > 0.f ? A + W * (Sum / Cnt - A) : A, 0.f);
	NormalDst[v] = float4(Cnt > 0.f ? An + W * (SumN / Cnt - An) : An, 0.f);
}

// 최종 위치 · 법선 → 내려받기 버퍼 · 화면 버퍼. 법선은 평활화한 것을 정규화 (splashsurf 의 법선 평활화 — 위치만 평활화하면
// 조명이 옛 혹 모양대로 비친다, #20)

[numthreads(64, 1, 1)]
void VertFinalCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint v = Tid.x;
	if (v >= min(CountersRO[3], MaxVerts)) { return; }
	const float3 X = SmoothSrc[v].xyz;
	const float3 N0 = NormalSrc[v].xyz;
	const float L2 = dot(N0, N0);
	const float3 Nrm = L2 > 1e-16f ? N0 * rsqrt(L2) : float3(0.f, 0.f, 0.f);
	// 정점 W = 입자 W 의 셰퍼드 보간 (VertWeightCS 와 같은 커널 (1 − d²/r²)³), 평활화 뒤 위치에서
	float Wv = 0.f;
	if (bHasWet)
	{
		const float R2 = NeighborR * NeighborR;
		float Sw = 0.f, Sww = 0.f;
		FOR_NEIGHBORS_ALL(X,
		{
			const float D2 = dot(PosRO[j].xyz - X, PosRO[j].xyz - X);
			if (D2 < R2) { const float T = 1.f - D2 / R2; const float K = T * T * T; Sw += K; Sww += K * WetRO[j]; }
		})
		Wv = Sw > 0.f ? Sww / Sw : 0.f;
	}
	SmoothDst[v] = float4(X, Wv);
	NormalDst[v] = float4(Nrm, 0.f);
	if (bRenderOut)
	{
		const uint C8 = (uint)round(saturate(Wv) * 255.f);
		RColRW[v] = C8 | (C8 << 8) | (C8 << 16) | (255u << 24);
		RPosRW[v * 3 + 0] = X.x; RPosRW[v * 3 + 1] = X.y; RPosRW[v * 3 + 2] = X.z;
		// 접선 = 법선에 수직인 아무 방향 (모래는 이방 질감이 없다). TangentZ.w = +1 (종법선 부호)
		const float3 Nz = L2 > 1e-16f ? Nrm : float3(0.f, 0.f, 1.f);
		const float3 Up = abs(Nz.z) < 0.999f ? float3(0.f, 0.f, 1.f) : float3(1.f, 0.f, 0.f);
		const float3 Tx = normalize(cross(Up, Nz));
		RTanRW[v * 2 + 0] = PackSNorm8(float4(Tx, 0.f));
		RTanRW[v * 2 + 1] = PackSNorm8(float4(Nz, 1.f));
	}
}
