// M3 T1 — 얕은 물 GPU 판 (m3-plan.md · m3-log #2). CPU 기준판 FSandGridCpu (BeachSimulator/Grid) 와 같은 식, float.
// KP07 central-upwind + Bollermann 2013 원천 · 배수 시간 + 2D 물가 칸 수면 하나 (부피 역산).
//
// 한 서브스텝 = SSP-RK2 두 단계. 단계마다:
//   LevelCS   칸 수면 L · 물가 칸 표시 (U 에서)
//   FaceXCS / FaceYCS   경계마다 양쪽 칸을 재구성해 central-upwind 유량 (H1 · H2a · H2g · H3), 최대 파속 원자 최대
//   DtCS      (1 단계만) Δt = min(CFL/a_max, 남은 시간) — CPU 가 기다리지 않는다
//   DrainCS   칸 배수 시간 (Bollermann 4.7)
//   UpdateCS  유량 차 + 원천 → 단계 갱신 (1: U1 = U0 + Δt·L(U0) · 2: U0 = ½(U0 + U1 + Δt·L(U1))) · 얕은 칸 운동량 0
//
// 상태 U = float4 (w, hu, hv, 0). 지형 = 꼭짓점 B (NX+1)·(NY+1). 경계 = 벽.

#include "/Engine/Public/Platform.ush"

uint  NX;
uint  NY;
float Dx;
float Dy;
float Gravity;
float Theta;
float Cfl;
float HDry;
float EpsDesing;
uint  bWetDry;
uint  Stage;            // 1 또는 2
uint  bFixedDt;
float FixedDt;
float Manning;
float ManningSwash;      // 진단 (papers D-M3-13): x < FricX (평균 물가선 땅 쪽) 칸 Manning
float FricX;
float ManningAt(uint i) { return (i + 0.5f) * Dx < FricX ? ManningSwash : Manning; }
float Ks;                // White-Colebrook (papers D-M3-15): > 0 이면 영역 전체 c_f = g/C², C = 18 log10(12h/k_s) — Manning · 구역 대신
float CfAt(uint i, float h)
{
	if (Ks > 0.f) { const float C = max(18.f * log10(12.f * h / Ks), 1.f); return Gravity / (C * C); }   // C ≥ 1: h < k_s/12 근처에서 흐름을 멈추는 수치 가드
	const float n = ManningAt(i);
	return Gravity * n * n / pow(h, 1.f / 3.f);
}
// T3 바다 쪽 경계 (+x, i = NX) — 리만 불변량 (papers D-M3-5): 나가는 R⁺ = u + 2√(gh) 안쪽에서, 들어오는 R⁻ 는 입사파로
uint  bOpenEast;
float SeaLevel;
float BoundaryDepth;     // 경계 정지 수심 h₀ = SeaLevel − B_경계
uint  NumWaves;
// T3b 장주기파 (B 안, m3-plan · papers D-M3-7/8): 쇄파점에서 풀려난 묶인 장주기파를 자유파로 입사.
// η_IG = IgGain · (A² − Σa²) — A = 짧은 파 포락선 (성분 복소 합), IgGain = Longuet-Higgins & Stewart (1962) 평형 식을 쇄파 수심에서 (CPU 가 계산)
float IgGain;
StructuredBuffer<float4> Waves;   // 성분마다 두 칸: (진폭 a, 각진동수 ω, 위상 φ, 해안선 방향 파수 k_y) · (u_n/η, v/η, 0, 0) — η_i(y, t) = Σ a·cos(φ + k_y·y − ω t)
uint  NumIg;             // T3c c4 묶인 장주기파 쌍 (Waves 의 NumWaves 뒤) — LHS 1962 방향 일반화 (m3-plan c4), CPU 가 계산
// T3c c4 한 방향 nesting — 동쪽 입사를 바깥 격자 경계 위치 값으로 (두 스냅샷 (η, u_n, v, t) 를 y · 시간 선형 보간)
uint  bNest;
uint  NestNY;
float NestDy;
float NestX;             // NestCS (바깥 격자에서): 안쪽 경계 x (m)
uint  DispTaper;         // 열린 경계 쪽 분산 줄이는 칸 수 (d → 0)
StructuredBuffer<float4>   NestARO;
StructuredBuffer<float4>   NestBRO;
RWStructuredBuffer<float4> NestOutRW;
// T3c c6 지하수 · 침투 (m3-plan c6, papers D-M3-12) — XBeach gwnonh=0: Dupuit Darcy + Green–Ampt 침투 + 침출. 서브스텝 끝 GwFluxCS → GwApplyCS
uint  bGround;
float GwK;               // 투수 계수 (m/s)
float GwPsi;             // 습윤 전선 흡인 ψ (m)
float GwNe;              // 유효 공극률
float GwZaq;             // 대수층 바닥 (m)
StructuredBuffer<float2>   GwRO;   // (η_gw 지하수면, δ 습윤 전선 깊이)
RWStructuredBuffer<float2> GwRW;
StructuredBuffer<float>    GwQRO;  // 칸 Darcy 순유입 (m/s)
RWStructuredBuffer<float>  GwQRW;
uint  bPeriodicY;        // 해안선 방향(y) 주기 경계 — 비스듬한 파도가 옆 벽에서 튕기지 않게 (k_y 는 2π m / L_y 로 맞춘다)          // 바닥 마찰 n (s/m^⅓) — CPU FixDry 와 같은 암시적 꼴

StructuredBuffer<float>    BCorner;
StructuredBuffer<float4>   URO;      // 이 단계 입력 (1 단계: U0, 2 단계: U1)
StructuredBuffer<float4>   U0RO;     // 2 단계에서 U0
RWStructuredBuffer<float4> UOutRW;   // 1 단계: U1, 2 단계: U0
RWStructuredBuffer<float2> LevelRW;  // (L, 물가 1/0)
StructuredBuffer<float2>   LevelRO;
RWStructuredBuffer<float4> FaceXRW;  // (H1, H2a, H2g, H3) — x 경계, (NX+1)·NY
RWStructuredBuffer<float4> FaceYRW;  //                     — y 경계, NX·(NY+1)
StructuredBuffer<float4>   FaceXRO;
StructuredBuffer<float4>   FaceYRO;
RWStructuredBuffer<float>  DrainRW;
StructuredBuffer<float>    DrainRO;
RWStructuredBuffer<uint>   AMaxRW;   // [0] 최대 a/Δ 의 float 비트 (양수라 uint 순서 = float 순서)
StructuredBuffer<uint>     AMaxRO;
RWStructuredBuffer<float>  TimeRW;   // [0] 이번 Δt · [1] 남은 시간 · [2] 쓴 시간 합
StructuredBuffer<float>    TimeRO;   // [4] 지난 서브스텝 Δt (분산 F* 시간 외삽)
// T3c Boussinesq 분산 (CPU StepBoussinesq 와 같은 식, papers D-M3-9). 상태 U.yz = P, Q (유량), 시간 적분은 UV = (U, V) 로
uint  bDispersive;
float BreakRatio;
float BreakStop;         // 쇄파 종료 ε (Tonelli & Petti 지속, papers D-M3-17). 0 이면 지속 없음 (순간 판정)
RWStructuredBuffer<float2> BrkRW;  // 칸별 (쇄파 상태 0/1, 지난 판정 때 수위 w) — 서브스텝 · 프레임을 넘어 유지 (이번 판정 쓰기)
StructuredBuffer<float2> BrkRO;    // 지난 판정 (핑퐁 — 이웃 상태를 경쟁 없이 읽는다)
float BreakSlope;
uint  BreakRoller;       // 1: 쇄파 칸을 묶어 roller 길이로 넓힘 (Kazolea & Ricchiuto 2018 · Bacigaluppi 2019, papers D-M3-22)
float BreakTbrk;         // 3 (FUNWAVE 나이): 쇄파 지속 시간 T_brk (s) — FUNWAVE 는 입사 주기
RWStructuredBuffer<float2> BrkDiagRW;   // 진단: 칸별 (최대 |∇η|, 최대 η_t/√(gH)) 누적 (m3-log #23)        // tan φ_c (기울기 쇄파 조건, 0 이면 끔)
float EddyDelta;         // Kennedy et al. (2000) δ_b (1.2) — ν = δ_b² (h+η) η_t (FUNWAVE-TVD 문서 식 (3), papers D-M3-19)
RWStructuredBuffer<float>  NuRW;   // 칸별 와점성 ν (m²/s) — BreakCS 가 쓰고 EddyCS 가 읽는다
StructuredBuffer<float>    NuRO;
RWStructuredBuffer<float>  EdCRW;  // 삼중대각 Thomas 앞 소거 c' (줄마다)
RWStructuredBuffer<float2> EdDRW;  // d' (P, Q 두 우변)
uint  BreakMode;         // 0: ε = |η − SeaLevel|/h (Tonelli & Petti) · 1: ε = (∂η/∂t)/√(gh) (SWASH HFA Smit 2013 · Kazolea 2014, papers D-M3-18)
uint  DispMode;          // DispCS — 1: 서브스텝 처음 (F*_t 외삽 · F* 저장도) · 2: 2 단계 입력
uint  LineAxis;          // SolveCS — 0: 행 (P ← U) · 1: 열 (Q ← V)
RWStructuredBuffer<float>  DstRW;     // 정지 수심 d (쇄파 칸은 −d, DstRaw 참고)
StructuredBuffer<float>    DstRO;
StructuredBuffer<float2>   UVRO;
RWStructuredBuffer<float2> UVRW;
RWStructuredBuffer<float2> FsPrevRW;  // 지난 서브스텝 F*, G*
RWStructuredBuffer<float2> FsTRW;     // F*_t, G*_t
StructuredBuffer<float2>   FsTRO;
RWStructuredBuffer<float2> DispRW;    // η 분산 항 (x, y)
StructuredBuffer<float2>   DispRO;

uint Idx(uint i, uint j) { return j * NX + i; }
int WJ(int j) { return bPeriodicY != 0u ? ((j % (int)NY) + (int)NY) % (int)NY : clamp(j, 0, (int)NY - 1); }   // 분산 스텐실 y (주기면 감싼다)
float Bc(uint ci, uint cj) { return BCorner[cj * (NX + 1) + ci]; }
float BFaceX(int i, uint j) { uint c = (uint)clamp(i + 1, 0, (int)NX); return 0.5f * (Bc(c, j) + Bc(c, j + 1)); }   // 칸 i 의 오른쪽 경계
float BFaceY(uint i, int j) { uint r = (uint)clamp(j + 1, 0, (int)NY); return 0.5f * (Bc(i, r) + Bc(i + 1, r)); }
float BCell(uint i, uint j) { return 0.25f * (BFaceX((int)i, j) + BFaceX((int)i - 1, j) + BFaceY(i, (int)j) + BFaceY(i, (int)j - 1)); }

float MinMod3(float a, float b, float c)
{
	if (a > 0.f && b > 0.f && c > 0.f) { return min(a, min(b, c)); }
	if (a < 0.f && b < 0.f && c < 0.f) { return max(a, max(b, c)); }
	return 0.f;
}

float Desing(float h, float q)
{
	// KP07 (2.17)
	const float h2 = h * h, h4 = h2 * h2;
	return 1.41421356f * h * q / sqrt(h4 + max(h4, EpsDesing));
}

// 거울 경계를 거친 칸. 유량 부호 반대는 SgnU/SgnV
void Mirror(int i, int j, out uint oi, out uint oj, out float SgnU, out float SgnV)
{
	SgnU = 1.f; SgnV = 1.f;
	if (bPeriodicY != 0u) { j = ((j % (int)NY) + (int)NY) % (int)NY; }
	if (i < 0) { i = -1 - i; SgnU = -1.f; } else if (i >= (int)NX) { i = 2 * (int)NX - 1 - i; SgnU = -1.f; }
	if (j < 0) { j = -1 - j; SgnV = -1.f; } else if (j >= (int)NY) { j = 2 * (int)NY - 1 - j; SgnV = -1.f; }
	oi = (uint)clamp(i, 0, (int)NX - 1); oj = (uint)clamp(j, 0, (int)NY - 1);
}

// ---------------------------------------------------------------------------------------------
// 물가 칸 수면 — 이선형 칸 위 max(0, L − B) 평균이 h̄ 가 되는 L (CPU CellLevel 과 같은 8×8 표본 · 이분법)
float CellVolume(float b00, float b10, float b01, float b11, float L)
{
	float V = 0.f;
	for (uint b = 0; b < 8; ++b)
	for (uint a = 0; a < 8; ++a)
	{
		const float u = (a + 0.5f) / 8.f, v = (b + 0.5f) / 8.f;
		V += max(0.f, L - ((1 - u) * (1 - v) * b00 + u * (1 - v) * b10 + (1 - u) * v * b01 + u * v * b11));
	}
	return V / 64.f;
}

[numthreads(8, 8, 1)]
void LevelCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const float w = URO[Idx(i, j)].x;
	float2 R = float2(w, 0.f);
	if (bWetDry != 0u)
	{
		const float b00 = Bc(i, j), b10 = Bc(i + 1, j), b01 = Bc(i, j + 1), b11 = Bc(i + 1, j + 1);
		const float Hi = max(max(b00, b10), max(b01, b11)), Lo = min(min(b00, b10), min(b01, b11));
		const float Bm = BCell(i, j);
		const float Hbar = w - Bm;
		if (Hbar < Hi - Bm && Hi - Lo > 1e-7f)
		{
			float A = Lo, B = Hi;
			const float Hb = max(0.f, Hbar);
			for (uint n = 0; n < 24; ++n) { const float M = 0.5f * (A + B); if (CellVolume(b00, b10, b01, b11, M) < Hb) { A = M; } else { B = M; } }
			R = float2(0.5f * (A + B), 1.f);
		}
	}
	LevelRW[Idx(i, j)] = R;
}

// ---------------------------------------------------------------------------------------------
// 칸 c (축 방향 번호) 의 재구성. Axis 0: c = i, m = j. 반환: 경계 −½ / +½ 의 (w, q 진행, r 가로)
struct FRec { float wm, wp, qm, qp, rm, rp, wbar, bm, bp; bool bPartial; };

// 입사파 (선형 얕은 물): η · 법선 속도 u_n (해안 쪽 −x 가 +) · 해안선 방향 속도 v. 성분마다 방향 θ: sinθ = k_y·c/ω
float3 IncidentWave(float t, float y, float h0)
{
	// 성분마다 u_n · v 계수는 CPU (선형 위상속도 — 분산이면 ω/k · 묶인 IG 는 연속식 ΩK/(hK²)). v 는 진행 +y 면 양수
	float3 E = 0;
	float Re = 0.f, Im = 0.f, A2m = 0.f;
	for (uint n = 0; n < NumWaves + NumIg; ++n)
	{
		const float4 W = Waves[2 * n], F = Waves[2 * n + 1];
		const float Ph = W.z + W.w * y - W.y * t;
		const float e = W.x * cos(Ph);
		E += float3(e, e * F.x, e * F.y);
		if (n < NumWaves) { Re += W.x * cos(Ph); Im += W.x * sin(Ph); A2m += W.x * W.x; }
	}
	// T3b 장주기파 (B 안) — 평균 0 (A² 의 평균 = Σa²) 이라 물이 쌓이지 않는다. 해안 쪽 법선 속도 = η·√(g/h₀)
	const float Eig = IgGain * (Re * Re + Im * Im - A2m);
	E += float3(Eig, Eig * sqrt(Gravity / h0), 0.f);
	return E;
}

// 바다 쪽 입사파 캐시 (m3-plan p2): FaceX 전에 경계 줄 j 마다 한 번 — 그룹 하나 (64 스레드) 가 성분 합을 나눠 더한다.
// 전엔 유령 칸 Fetch 마다 (면당 최대 6 번) 528 성분 cos · sin — 경계 열 스레드만 길어 패스를 붙잡았다 (m3-log #31)
RWStructuredBuffer<float4> IncRW;
StructuredBuffer<float4>   IncRO;
uint bIncCached;
groupshared float4 IncS[64];
[numthreads(64, 1, 1)]
void IncCS(uint3 Gid : SV_GroupID, uint3 Gt : SV_GroupThreadID)
{
	const uint j = Gid.x, l = Gt.x;
	const float t = TimeRO[2], y = (j + 0.5f) * Dy, h0 = max(BoundaryDepth, 1e-3f);
	float3 E = 0; float Re = 0.f, Im = 0.f, A2m = 0.f;
	for (uint n = l; n < NumWaves + NumIg; n += 64u)
	{
		const float4 W = Waves[2 * n], F = Waves[2 * n + 1];
		const float Ph = W.z + W.w * y - W.y * t;
		const float e = W.x * cos(Ph);
		E += float3(e, e * F.x, e * F.y);
		if (n < NumWaves) { Re += W.x * cos(Ph); Im += W.x * sin(Ph); A2m += W.x * W.x; }
	}
	IncS[l] = float4(E, A2m);
	GroupMemoryBarrierWithGroupSync();
	for (uint s = 32u; s > 0u; s >>= 1u) { if (l < s) { IncS[l] += IncS[l + s]; } GroupMemoryBarrierWithGroupSync(); }
	const float4 Es = IncS[0];
	GroupMemoryBarrierWithGroupSync();
	IncS[l] = float4(Re, Im, 0.f, 0.f);   // Re · Im 은 제곱 전에 합해야 하므로 따로 줄인다
	GroupMemoryBarrierWithGroupSync();
	for (uint s = 32u; s > 0u; s >>= 1u) { if (l < s) { IncS[l] += IncS[l + s]; } GroupMemoryBarrierWithGroupSync(); }
	if (l == 0u)
	{
		const float Rs = IncS[0].x, Is = IncS[0].y;
		const float Eig = IgGain * (Rs * Rs + Is * Is - Es.w);
		IncRW[j] = float4(Es.xyz + float3(Eig, Eig * sqrt(Gravity / h0), 0.f), 0.f);
	}
}

float3 NestWave(float t, float y)
{
	const float yo = y / NestDy - 0.5f, j0f = floor(yo), f = yo - j0f;
	const uint j0 = (uint)((((int)j0f) % (int)NestNY + (int)NestNY) % (int)NestNY), j1 = (j0 + 1u) % NestNY;
	const float4 A = lerp(NestARO[j0], NestARO[j1], f), B = lerp(NestBRO[j0], NestBRO[j1], f);
	const float s = saturate((t - NestARO[0].w) / max(NestBRO[0].w - NestARO[0].w, 1e-6f));
	return lerp(A, B, s).xyz;
}

void Fetch(uint Axis, int c, uint m, out float w, out float q, out float r, out float L, out bool bPart, out float bm, out float bp)
{
	int i = Axis == 0 ? c : (int)m, j = Axis == 0 ? (int)m : c;
	if (bOpenEast != 0u && i >= (int)NX)
	{
		// 바다 쪽 유령 칸: 안쪽 끝 칸의 나가는 불변량 + 입사파의 들어오는 불변량 (선형 입사 u_i = −η_i·√(g/h₀), −x 로 진행)
		const uint kIn = Idx(NX - 1, j < 0 ? 0u : min((uint)j, NY - 1));
		const float4 Ui = URO[kIn];
		const float Bb = BFaceX((int)NX - 1, Axis == 0 ? m : (uint)clamp(j, 0, (int)NY - 1));
		const float hIn = max(0.f, Ui.x - Bb);
		const float uIn = hIn > 0.f ? Desing(hIn, Ui.y) : 0.f;
		float vIn;
		const float h0 = max(BoundaryDepth, 1e-3f);
		const int jj = Axis == 0 ? (int)m : j;
		const float3 Inc = bNest != 0u ? NestWave(TimeRO[2], (jj + 0.5f) * Dy) : (bIncCached != 0u ? IncRO[WJ(jj)].xyz : IncidentWave(TimeRO[2], (jj + 0.5f) * Dy, h0));
		const float Eta = Inc.x;
		const float Rp = uIn + 2.f * sqrt(Gravity * hIn);
		const float Rm = -Inc.y - 2.f * sqrt(Gravity * max(0.f, h0 + Eta));   // 들어오는 불변량 — 법선 성분만 (van Dongeren & Svendsen 1997)
		vIn = Inc.z;   // 해안선 방향 속도는 들어오는 파가 실어 온다
		const float Cg = max(0.f, 0.25f * (Rp - Rm));
		const float hG = Cg * Cg / Gravity, uG = 0.5f * (Rp + Rm);
		w = Bb + hG; L = w; bPart = false;
		q = Axis == 0 ? hG * uG : hG * vIn; r = Axis == 0 ? hG * vIn : hG * uG;
		bm = Bb; bp = Bb;
		return;
	}
	uint oi, oj; float Su, Sv;
	Mirror(i, j, oi, oj, Su, Sv);
	const float4 U = URO[Idx(oi, oj)];
	const float2 Lv = LevelRO[Idx(oi, oj)];
	w = U.x; L = Lv.x; bPart = Lv.y > 0.5f;
	const float qu = U.y * Su, qv = U.z * Sv;
	q = Axis == 0 ? qu : qv; r = Axis == 0 ? qv : qu;
	// 이 칸의 진행 방향 두 경계 지형 (거울 칸이 아니라 원래 번호 기준 — CPU FaceB 의 clamp 와 같다)
	if (Axis == 0) { bm = BFaceX(clamp(c - 1, -1, (int)NX - 1), m); bp = BFaceX(clamp(c, -1, (int)NX - 1), m); }
	else           { bm = BFaceY(m, clamp(c - 1, -1, (int)NY - 1)); bp = BFaceY(m, clamp(c, -1, (int)NY - 1)); }
}

FRec Reconstruct(uint Axis, int c, uint m)
{
	float w0, q0, r0, l0, w1, q1, r1, l1, w2, q2, r2, l2, bm, bp, d0, d1;
	bool p0, p1, p2;
	Fetch(Axis, c - 1, m, w0, q0, r0, l0, p0, d0, d1);
	Fetch(Axis, c + 1, m, w2, q2, r2, l2, p2, d0, d1);
	Fetch(Axis, c, m, w1, q1, r1, l1, p1, bm, bp);
	const float sw = MinMod3(Theta * (l1 - l0), 0.5f * (l2 - l0), Theta * (l2 - l1));   // 기울기는 수면 L 로 (Bollermann Remark 3.1)
	const float sq = MinMod3(Theta * (q1 - q0), 0.5f * (q2 - q0), Theta * (q2 - q1));
	const float sr = MinMod3(Theta * (r1 - r0), 0.5f * (r2 - r0), Theta * (r2 - r1));
	FRec R;
	R.wm = w1 - 0.5f * sw; R.wp = w1 + 0.5f * sw;
	R.qm = q1 - 0.5f * sq; R.qp = q1 + 0.5f * sq;
	R.rm = r1 - 0.5f * sr; R.rp = r1 + 0.5f * sr;
	R.wbar = w1; R.bm = bm; R.bp = bp; R.bPartial = p1;
	if (p1) { R.wm = max(l1, bm); R.wp = max(l1, bp); }   // 물가 칸: 평평한 수면 L
	else
	{
		if (R.wp < bp) { R.wp = bp; R.wm = 2.f * w1 - bp; }   // KP07 (2.15)/(2.16)
		else if (R.wm < bm) { R.wm = bm; R.wp = 2.f * w1 - bm; }
	}
	return R;
}

float4 FaceFlux(uint Axis, int c, uint m, float D)   // 경계 c+½
{
	const FRec L = Reconstruct(Axis, c, m);
	const FRec R = Reconstruct(Axis, c + 1, m);
	const float Bf = L.bp;
	const float hL = max(0.f, L.wp - Bf), hR = max(0.f, R.wm - Bf);
	const float uL = hL > 0.f ? Desing(hL, L.qp) : 0.f, vL = hL > 0.f ? Desing(hL, L.rp) : 0.f;
	const float uR = hR > 0.f ? Desing(hR, R.qm) : 0.f, vR = hR > 0.f ? Desing(hR, R.rm) : 0.f;
	const float qL = hL * uL, qR = hR * uR, rL = hL * vL, rR = hR * vR;
	const float cL = sqrt(Gravity * hL), cR = sqrt(Gravity * hR);
	const float ap = max(max(uL + cL, uR + cR), 0.f), am = min(min(uL - cL, uR - cR), 0.f);
	uint D0;
	InterlockedMax(AMaxRW[0], asuint(max(ap, -am) / D), D0);
	float4 F = 0;
	if (ap - am > 1e-12f)
	{
		const float Inv = 1.f / (ap - am), Dif = ap * am * Inv;
		F.x = (ap * qL - am * qR) * Inv + Dif * (hR - hL);
		F.y = (ap * qL * uL - am * qR * uR) * Inv;
		F.z = (ap * 0.5f * Gravity * hL * hL - am * 0.5f * Gravity * hR * hR) * Inv + Dif * (qR - qL);
		F.w = (ap * rL * uL - am * rR * uR) * Inv + Dif * (rR - rL);
	}
	return F;
}

[numthreads(8, 8, 1)]
void FaceXCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint f = Tid.x, j = Tid.y;   // f = 0..NX: 칸 f−1 의 오른쪽 경계
	if (f > NX || j >= NY) { return; }
	FaceXRW[j * (NX + 1) + f] = FaceFlux(0, (int)f - 1, j, Dx);
}

[numthreads(8, 8, 1)]
void FaceYCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x, f = Tid.y;
	if (i >= NX || f > NY) { return; }
	FaceYRW[f * NX + i] = FaceFlux(1, (int)f - 1, i, Dy);
}

[numthreads(1, 1, 1)]
void DtCS(uint3 Tid : SV_DispatchThreadID)
{
	const float A = asfloat(AMaxRO[0]);
	float Dt = bFixedDt != 0u ? FixedDt : (A > 0.f ? Cfl / A : 1e-3f);
	const float Rem = TimeRW[1];
	if (bFixedDt == 0u) { Dt = min(Dt, max(Rem, 0.f)); }
	TimeRW[0] = Dt;
	TimeRW[1] = Rem - Dt;
	TimeRW[2] = TimeRW[2] + Dt;
	TimeRW[3] = max(TimeRW[3], A);
	TimeRW[4] = Dt;   // 이번 Advance 의 최대 a/Δ — CPU 가 다음 프레임 서브스텝 수를 정한다
}

[numthreads(8, 8, 1)]
void DrainCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const float Dt = TimeRO[0];
	float Dr = Dt;
	if (bWetDry != 0u)
	{
		const float Out = max(0.f, FaceXRO[j * (NX + 1) + i + 1].x) / Dx + max(0.f, -FaceXRO[j * (NX + 1) + i].x) / Dx
		                + max(0.f, FaceYRO[(j + 1) * NX + i].x) / Dy + max(0.f, -FaceYRO[j * NX + i].x) / Dy;
		const float h = URO[Idx(i, j)].x - BCell(i, j);
		if (Out > 0.f) { Dr = min(Dt, max(0.f, h) / Out); }
	}
	DrainRW[Idx(i, j)] = Dr;
}

float Scale(float H1, int kLeft, int kRight, float Dt)
{
	const int Up = H1 >= 0.f ? kLeft : kRight;
	return (Up >= 0 && Dt > 0.f) ? DrainRO[Up] / Dt : 1.f;
}

[numthreads(8, 8, 1)]
void UpdateCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const uint k = Idx(i, j);
	const float Dt = TimeRO[0];
	const float4 XL = FaceXRO[j * (NX + 1) + i], XR = FaceXRO[j * (NX + 1) + i + 1];
	const float4 YL = FaceYRO[j * NX + i], YR = FaceYRO[(j + 1) * NX + i];
	const float sXL = Scale(XL.x, i > 0 ? (int)k - 1 : -1, (int)k, Dt), sXR = Scale(XR.x, (int)k, i + 1 < NX ? (int)k + 1 : -1, Dt);
	const float sYL = Scale(YL.x, j > 0 ? (int)(k - NX) : -1, (int)k, Dt), sYR = Scale(YR.x, (int)k, j + 1 < NY ? (int)(k + NX) : -1, Dt);
	float3 L;
	L.x = -((sXR * XR.x - sXL * XL.x) / Dx + (sYR * YR.x - sYL * YL.x) / Dy);
	L.y = -((sXR * XR.y - sXL * XL.y + XR.z - XL.z) / Dx + (sYR * YR.w - sYL * YL.w) / Dy);
	L.z = -((sYR * YR.y - sYL * YL.y + YR.z - YL.z) / Dy + (sXR * XR.w - sXL * XL.w) / Dx);
	// 원천 — 잠긴 칸 −g·h̄·ΔB/Δ (Bollermann 2.7), 물가 칸 g/2·(h_E² − h_W²)/Δ (m3-log #2)
	[unroll] for (uint Axis = 0; Axis < 2; ++Axis)
	{
		const FRec R = Reconstruct(Axis, Axis == 0 ? (int)i : (int)j, Axis == 0 ? j : i);
		const float D = Axis == 0 ? Dx : Dy;
		const float Hbar = R.wbar - 0.5f * (R.bm + R.bp);
		const float hE = R.wp - R.bp, hW = R.wm - R.bm;
		const float Src = R.bPartial ? 0.5f * Gravity * (hE * hE - hW * hW) / D : -Gravity * Hbar * (R.bp - R.bm) / D;
		if (Axis == 0) { L.y += Src; } else { L.z += Src; }
	}
	const float4 U = URO[k];
	float4 O;
	if (bDispersive != 0u)
	{
		// U · V 를 적분 (1 단계: UVRO = UV0 → UVRW = UV1 · 2 단계: UVRO = UV1, UVRW = UV0 제자리). P, Q 는 뒤 SolveCS 가, 마른 칸 · 마찰은 FixCS 가
		const float2 Dd = L.yz + DispRO[k] + FsTRO[k];
		if (Stage == 1) { O = float4(U.x + Dt * L.x, 0.f, 0.f, 0.f); UVRW[k] = UVRO[k] + Dt * Dd; }
		else            { O = float4(0.5f * (U0RO[k].x + U.x + Dt * L.x), 0.f, 0.f, 0.f); UVRW[k] = 0.5f * (UVRW[k] + UVRO[k] + Dt * Dd); }
		UOutRW[k] = O;
		return;
	}
	if (Stage == 1) { O = float4(U.xyz + Dt * L, 0.f); }
	else            { const float4 A = U0RO[k]; O = float4(0.5f * (A.xyz + U.xyz + Dt * L), 0.f); }
	const float h = O.x - BCell(i, j);
	if (h < HDry) { O.y = 0.f; O.z = 0.f; }
	else if (CfAt(i, h) > 0.f)
	{
		const float Uv = sqrt(O.y * O.y + O.z * O.z) / h;
		const float Dn = 1.f + Dt * CfAt(i, h) * Uv / h;   // τ/ρ = c_f |u| u, 암시적
		O.y /= Dn; O.z /= Dn;
	}
	UOutRW[k] = O;
}

// ---------------------------------------------------------------------------------------------
// T3c — Madsen & Sørensen (1992) Boussinesq (Celeris 방식). CPU FSandGridCpu::Dst · ToU · SolveP · Dispersion 과 같은 식
static const float BMS = 1.f / 15.f;

// Dst: 정지 수심 d, 쇄파 칸은 음수 (−d). 칸 자신의 분산 계수는 max(·, 0) (쇄파면 0), 이웃 미분은 |·| (참 수심) —
// FUNWAVE-TVD 처럼 쇄파 마스크 (MASK9) 는 그 칸의 행 · 항에만 곱하고 수심장은 건드리지 않는다 (etauv_solver.F: tmp1~4 에 MASK9(I,J), depl · depr 은 그대로).
// 수심장을 0 으로 바꾸면 이웃 칸의 d_x 가 튀어 결합이 불안정해진다 (m3-log #20 · #21)
float DstRaw(int i, int j) { return DstRO[Idx((uint)clamp(i, 0, (int)NX - 1), (uint)WJ(j))]; }
// 칸 자신의 계수: 3×3 이웃 중 하나라도 쇄파면 0 (FUNWAVE MASK9 가 3×3 곱인 것과 같은 꼴 — 쇄파 경계가 2D 로 깜빡일 때
// y 교차 미분이 끊긴 이웃에서 터지던 것 (m3-log #21 _nan.bin: x 55~70 m, 수심 1.2~1.4 m, 모든 j 바둑판) 을 막는다)
float DstAt(int i, int j)
{
	float m = DstRaw(i, j);
	[unroll] for (int a = -1; a <= 1; ++a) [unroll] for (int b = -1; b <= 1; ++b) { if (DstRaw(i + a, j + b) < 0.f) { m = 0.f; } }
	return max(m, 0.f);
}
float DepAt(int i, int j) { return abs(DstRaw(i, j)); }

[numthreads(8, 8, 1)]
void BreakCS(uint3 Tid : SV_DispatchThreadID)
{
	// 쇄파 판정 (Tonelli & Petti 2009): |η|/h > BreakRatio → d = 0 (얕은 물로)
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const float w = URO[Idx(i, j)].x, Bm = BCell(i, j), h = w - Bm;
	const float2 Prev = BrkRO[Idx(i, j)];
	const float Dt = TimeRO[0];   // 지난 판정과의 간격 ≈ 이번 서브스텝 Δt (적응 Δt 라 근사)
	float Eps = 0.f;
	const float EtaT = (w - Prev.y) / max(Dt, 1e-6f);   // ∂η/∂t (지난 판정 이후)
	// ε 판정 (0) 의 분모는 정지 수심 h₀ = SeaLevel − B — FUNWAVE-TVD breaker.F `ABS(Eta)/MAX(DEPTH,MinDepthFrc)`, Bacigaluppi 2019 "A/h (still water depth)".
	// 전체 수심으로 나누면 ε = η/(h₀+η) < 1 이라 0.8 은 η > 4h₀ 에서야 켜진다 — 바깥 격자에서 쇄파가 사실상 안 일어나던 원인 (m3-log #21).
	// ∂η/∂t 판정 (1 · 2) 은 FUNWAVE 와 같이 √(g·전체 수심) (`tmp3 = SQRT(GRAV*MAX(MinDepthFrc,H))`). 땅 (h₀ ≤ HDry) 은 이미 d = 0 이라 판정 안 함
	const float H0s = SeaLevel - Bm;
	if (h > HDry && H0s > HDry) { Eps = BreakMode >= 1u ? EtaT / sqrt(Gravity * h) : abs(w - SeaLevel) / H0s; }   // 1 · 2: 수면 상승 속도만 (앞면)
	// 지속 (SWASH HFA, Smit 2013): 자기 또는 이웃 (4 방향) 이 지난 판정에 쇄파였으면 ε > BreakStop 까지 — 앞면을 따라 영역이 이어진다
	bool bWas = Prev.x > 0.5f;
	if (BreakMode == 1u)
	{
		if (i > 0u)      { bWas = bWas || BrkRO[Idx(i - 1u, j)].x > 0.5f; }
		if (i + 1u < NX) { bWas = bWas || BrkRO[Idx(i + 1u, j)].x > 0.5f; }
		if (j > 0u)      { bWas = bWas || BrkRO[Idx(i, j - 1u)].x > 0.5f; }
		if (j + 1u < NY) { bWas = bWas || BrkRO[Idx(i, j + 1u)].x > 0.5f; }
	}
	bWas = bWas && BreakStop > 0.f;
	// 2 (와점성): 기울기 조건도 — |∇η| ≥ tan φ_c (Kazolea & Ricchiuto 2018 · Kazolea 2014, φ_c 30°). 느린 · 멈춘 도수와 성긴 격자에서
	// η_t 가 문턱에 못 미치는 가파른 앞면을 잡는다 (D-M3-20). BreakSlope 0 이면 끔
	bool bSlope = false;
	if (h > HDry && H0s > HDry)
	{
		const int ii = (int)i, jj = (int)j;
		const float Ex = (URO[Idx((uint)min(ii + 1, (int)NX - 1), j)].x - URO[Idx((uint)max(ii - 1, 0), j)].x) / (2.f * Dx);
		const float Ey = (URO[Idx(i, (uint)WJ(jj + 1))].x - URO[Idx(i, (uint)WJ(jj - 1))].x) / (2.f * Dy);
		const float Sl = sqrt(Ex * Ex + Ey * Ey);
		bSlope = BreakMode == 2u && BreakSlope > 0.f && Sl >= BreakSlope;
	}
	const bool bBrk = BreakRatio > 0.f && h > HDry && H0s > HDry && (Eps > (bWas ? BreakStop : BreakRatio) || bSlope);   // 시작 BreakRatio · 켜진 뒤엔 ε < BreakStop 까지 유지
	BrkRW[Idx(i, j)] = float2(bBrk ? 1.f : 0.f, w);
	// 2: Kennedy 와점성 — 전환 없이 (분산 유지) ν 만. B = 1 (FUNWAVE-TVD), 켜짐 · 꺼짐은 위 지속 판정 (C_brk1 · C_brk2)
	float NuV = BreakMode == 2u && bBrk ? EddyDelta * EddyDelta * h * max(EtaT, 0.f) : 0.f;
	if (BreakMode == 3u)
	{
		// FUNWAVE-TVD breaker.F (기본 컴파일) 를 옮김 (papers D-M3-21): 칸별 쇄파 나이 AGE (BrkRO.x).
		// 시작: η_t ≥ C1√(gH) 이고 (AGE = 0 또는 > T_brk) → AGE = Δt. 진행 중: AGE += Δt.
		// 번짐: AGE = 0 이고 η_t ≥ C2√(gH) 일 때, 파 진행 방향 (−∇η) 의 위쪽 이웃 셋 중 하나가 AGE ≥ Δt 이고 AGE > 그 거리 / c 이면 AGE = Δt.
		// ν = H · C2 · √(gH) (정적) — 0 < AGE < T_brk 이고 η_t > C2√(gH) 인 칸.
		const float Sq = sqrt(Gravity * max(h, HDry)), T1 = BreakRatio * Sq, T2 = BreakStop * Sq;
		float Age = Prev.x;
		if (h > HDry && H0s > HDry)
		{
			if (EtaT >= T1 && (Age <= 0.f || Age > BreakTbrk)) { Age = Dt; }
			else if (Age > 0.f) { Age += Dt; }
			else if (EtaT >= T2)
			{
				const int ii = (int)i, jj = (int)j;
				const float Ex = (URO[Idx((uint)min(ii + 1, (int)NX - 1), j)].x - URO[Idx((uint)max(ii - 1, 0), j)].x) / (2.f * Dx);
				const float Ey = (URO[Idx(i, (uint)WJ(jj + 1))].x - URO[Idx(i, (uint)WJ(jj - 1))].x) / (2.f * Dy);
				const float Gm = max(sqrt(Ex * Ex + Ey * Ey), 1e-6f);
				const float C = min(abs(EtaT) / Gm, sqrt(Gravity * abs(h)));
				const float Px = Dx / max(C, 1e-6f), Py = Dy / max(C, 1e-6f), Pxy = sqrt(Dx * Dx + Dy * Dy) / max(C, 1e-6f);
				const int sx = -Ex >= 0.f ? -1 : 1, sy = -Ey >= 0.f ? -1 : 1;   // 위쪽 (파가 온 쪽) 이웃 방향
				const float A1 = BrkRO[Idx((uint)clamp(ii + sx, 0, (int)NX - 1), j)].x;
				const float A2 = BrkRO[Idx((uint)clamp(ii + sx, 0, (int)NX - 1), (uint)WJ(jj + sy))].x;
				const float A3 = BrkRO[Idx(i, (uint)WJ(jj + sy))].x;
				if ((A1 >= Dt && A1 > Px) || (A2 >= Dt && A2 > Pxy) || (A3 >= Dt && A3 > Py)) { Age = Dt; }
			}
		}
		else { Age = 0.f; }
		const bool bOn = Age > 0.f && Age < BreakTbrk && EtaT > T2;
		NuV = bOn ? h * T2 : 0.f;
		BrkRW[Idx(i, j)] = float2(Age, w);
	}
	NuRW[Idx(i, j)] = NuV;
	if (h > HDry && H0s > HDry) { const float2 Dg = BrkDiagRW[Idx(i, j)]; BrkDiagRW[Idx(i, j)] = float2(Dg.x + (NuV > 0.f && BreakRoller == 0u ? Dt : 0.f), max(Dg.y, Eps)); }   // 진단: x = ν > 0 누적 시간 (s, m3-log #24), y = 최대 ε
	if (BreakMode >= 2u)
	{
		const float TpE = bOpenEast != 0u && DispTaper > 0u ? saturate((float)(NX - 1u - i) / (float)DispTaper) : 1.f;
		DstRW[Idx(i, j)] = TpE * max(0.f, SeaLevel - Bm);
		return;
	}
	// 열린 경계 쪽 DispTaper 칸에서 d → 0 (경계 칸은 얕은 물 — 리만 경계와 맞게, m3-plan c4)
	const float Tp = bOpenEast != 0u && DispTaper > 0u ? saturate((float)(NX - 1u - i) / (float)DispTaper) : 1.f;
	DstRW[Idx(i, j)] = (bBrk ? -1.f : 1.f) * Tp * max(0.f, SeaLevel - Bm);   // 쇄파 = 음수 (위 DstRaw 참고)
}

float2 PQWall(int i, int j, uint Axis)   // 벽 거울 (수직 유량 부호 반대) — CPU ToU 의 At
{
	float S = 1.f;
	if (Axis == 0) { if (i < 0) { i = -1 - i; S = -1.f; } else if (i >= (int)NX) { i = 2 * (int)NX - 1 - i; S = -1.f; } }
	else if (bPeriodicY != 0u) { j = WJ(j); }
	else           { if (j < 0) { j = -1 - j; S = -1.f; } else if (j >= (int)NY) { j = 2 * (int)NY - 1 - j; S = -1.f; } }
	return S * URO[Idx((uint)clamp(i, 0, (int)NX - 1), (uint)clamp(j, 0, (int)NY - 1))].yz;
}

[numthreads(8, 8, 1)]
void ToUCS(uint3 Tid : SV_DispatchThreadID)
{
	// U = P − (B+⅓)d²P_xx − ⅓·d·d_x·P_x (V 는 y 꼴)
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const int ii = (int)i, jj = (int)j;
	const float d = DstAt(ii, jj), dx = (DepAt(ii + 1, jj) - DepAt(ii - 1, jj)) / (2 * Dx), dy = (DepAt(ii, jj + 1) - DepAt(ii, jj - 1)) / (2 * Dy);
	const float b = (BMS + 1.f / 3.f) * d * d;
	const float2 C = URO[Idx(i, j)].yz;
	const float Pe = PQWall(ii + 1, jj, 0).x, Pw = PQWall(ii - 1, jj, 0).x, Qn = PQWall(ii, jj + 1, 1).y, Qs = PQWall(ii, jj - 1, 1).y;
	UVRW[Idx(i, j)] = float2(C.x - b * (Pe - 2 * C.x + Pw) / (Dx * Dx) - d * dx / 3.f * (Pe - Pw) / (2 * Dx),
	                         C.y - b * (Qn - 2 * C.y + Qs) / (Dy * Dy) - d * dy / 3.f * (Qn - Qs) / (2 * Dy));
}

float EtaAt(int i, int j) { return URO[Idx((uint)clamp(i, 0, (int)NX - 1), (uint)WJ(j))].x - SeaLevel; }
float HAt(int i, int j) { const uint a = (uint)clamp(i, 0, (int)NX - 1), b = (uint)WJ(j); return URO[Idx(a, b)].x - BCell(a, b); }
float2 PQAt(int i, int j) { return URO[Idx((uint)clamp(i, 0, (int)NX - 1), (uint)WJ(j))].yz; }

[numthreads(8, 8, 1)]
void DispCS(uint3 Tid : SV_DispatchThreadID)
{
	// η 분산 항 + F*, G*. 이웃 ±2 칸이 다 젖은 곳에서만 (물가는 얕은 물로)
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const uint k = Idx(i, j);
	const int ii = (int)i, jj = (int)j;
	float2 Ds = 0, Fs = 0;
	const float d = DstAt(ii, jj);
	bool bWet = d > 0.f;
	for (int o = -2; o <= 2; ++o) { bWet = bWet && HAt(ii + o, jj) > HDry && HAt(ii, jj + o) > HDry; }
	if (bWet)
	{
		const float dx = (DepAt(ii + 1, jj) - DepAt(ii - 1, jj)) / (2 * Dx), dy = (DepAt(ii, jj + 1) - DepAt(ii, jj - 1)) / (2 * Dy);
		const float E = EtaAt(ii, jj);
		const float Ee = EtaAt(ii + 1, jj), Ew = EtaAt(ii - 1, jj), En = EtaAt(ii, jj + 1), Es = EtaAt(ii, jj - 1);
		const float Ene = EtaAt(ii + 1, jj + 1), Enw = EtaAt(ii - 1, jj + 1), Ese = EtaAt(ii + 1, jj - 1), Esw = EtaAt(ii - 1, jj - 1);
		const float Exx = (Ee - 2 * E + Ew) / (Dx * Dx), Eyy = (En - 2 * E + Es) / (Dy * Dy);
		const float Exy = (Ene - Enw - Ese + Esw) / (4 * Dx * Dy);
		const float Exxx = (EtaAt(ii + 2, jj) - 2 * Ee + 2 * Ew - EtaAt(ii - 2, jj)) / (2 * Dx * Dx * Dx);
		const float Eyyy = (EtaAt(ii, jj + 2) - 2 * En + 2 * Es - EtaAt(ii, jj - 2)) / (2 * Dy * Dy * Dy);
		const float Exyy = ((Ene - 2 * Ee + Ese) - (Enw - 2 * Ew + Esw)) / (2 * Dx * Dy * Dy);
		const float Exxy = ((Ene - 2 * En + Enw) - (Ese - 2 * Es + Esw)) / (2 * Dx * Dx * Dy);
		const float g = Gravity;
		Ds.x = BMS * g * d * d * d * (Exxx + Exyy) + BMS * g * d * d * (dx * (2 * Exx + Eyy) + dy * Exy);
		Ds.y = BMS * g * d * d * d * (Eyyy + Exxy) + BMS * g * d * d * (dy * (2 * Eyy + Exx) + dx * Exy);
		const float2 Cne = PQAt(ii + 1, jj + 1), Cnw = PQAt(ii - 1, jj + 1), Cse = PQAt(ii + 1, jj - 1), Csw = PQAt(ii - 1, jj - 1);
		const float2 Cxy = (Cne - Cnw - Cse + Csw) / (4 * Dx * Dy);
		const float2 Cx = (PQAt(ii + 1, jj) - PQAt(ii - 1, jj)) / (2 * Dx), Cy = (PQAt(ii, jj + 1) - PQAt(ii, jj - 1)) / (2 * Dy);
		Fs.x = (BMS + 1.f / 3.f) * d * d * Cxy.y + d * dx / 6.f * Cy.y + d * dy / 6.f * Cx.y;
		Fs.y = (BMS + 1.f / 3.f) * d * d * Cxy.x + d * dy / 6.f * Cx.x + d * dx / 6.f * Cy.x;
	}
	DispRW[k] = Ds;
	if (DispMode == 1u)
	{
		const float DtP = TimeRO[4];
		FsTRW[k] = DtP > 0.f ? (Fs - FsPrevRW[k]) / DtP : float2(0.f, 0.f);
		FsPrevRW[k] = Fs;
	}
}

// 삼중대각 — 행 · 열 하나를 그룹 하나가 병렬 순환 축소 (PCR, Zhang et al. 2010) 로. 줄 길이 ≤ 1024, 벽 경계 (바깥 칸 = −안쪽)
#define LINE_MAX 1024
groupshared float SA[LINE_MAX], SB[LINE_MAX], SC[LINE_MAX], SD[LINE_MAX], SE[LINE_MAX];   // SE = Sherman–Morrison 두 번째 우변

[numthreads(LINE_MAX, 1, 1)]
void SolveCS(uint3 Gid : SV_GroupID, uint3 Gtid : SV_GroupThreadID)
{
	const uint Line = Gid.x, t = Gtid.x;
	const uint N = LineAxis == 0 ? NX : NY;
	const bool bCyc = LineAxis == 1 && bPeriodicY != 0u;   // 주기 y — 순환 삼중대각을 Sherman–Morrison 으로 (보정 행렬 + 우변 두 개)
	float a = 0.f, b = 1.f, c = 0.f, r = 0.f, e = 0.f;
	if (t < N)
	{
		const int i = LineAxis == 0 ? (int)t : (int)Line, j = LineAxis == 0 ? (int)Line : (int)t;
		const float D = LineAxis == 0 ? Dx : Dy;
		const float d = DstAt(i, j);
		const float dd = LineAxis == 0 ? (DepAt(i + 1, j) - DepAt(i - 1, j)) / (2 * D) : (DepAt(i, j + 1) - DepAt(i, j - 1)) / (2 * D);
		const float bb = (BMS + 1.f / 3.f) * d * d / (D * D), aa = d * dd / 3.f / (2 * D);
		a = -bb + aa; b = 1 + 2 * bb; c = -bb - aa;
		if (!bCyc && t == 0) { b -= a; a = 0.f; }
		if (!bCyc && t == N - 1) { b -= c; c = 0.f; }
		const float2 UV = UVRO[Idx((uint)i, (uint)j)];
		r = LineAxis == 0 ? UV.x : UV.y;
	}
	SA[t] = a; SB[t] = b; SC[t] = c;
	GroupMemoryBarrierWithGroupSync();
	const float A0 = SA[0], CN = SC[N - 1], Gm = -SB[0] - 1.f;   // γ (0 이 아니게 −b₀ − 1, b₀ ≥ 1)
	if (bCyc)
	{
		// A = A' + u vᵀ, u = (γ, 0…, c_{N−1}), v = (1, 0…, a₀/γ)
		if (t == 0) { b -= Gm; a = 0.f; e = Gm; }
		if (t == N - 1) { b -= A0 * CN / Gm; c = 0.f; e = CN; }
	}
	GroupMemoryBarrierWithGroupSync();
	SA[t] = a; SB[t] = b; SC[t] = c; SD[t] = r; SE[t] = e;
	GroupMemoryBarrierWithGroupSync();
	for (uint s = 1; s < LINE_MAX; s <<= 1)
	{
		float am = 0.f, bm = 1.f, cm = 0.f, dm = 0.f, em = 0.f, ap = 0.f, bp = 1.f, cp = 0.f, dp = 0.f, ep = 0.f;
		if (t >= s) { am = SA[t - s]; bm = SB[t - s]; cm = SC[t - s]; dm = SD[t - s]; em = SE[t - s]; }
		if (t + s < LINE_MAX) { ap = SA[t + s]; bp = SB[t + s]; cp = SC[t + s]; dp = SD[t + s]; ep = SE[t + s]; }
		const float k1 = a / bm, k2 = c / bp;
		const float na = -am * k1, nc = -cp * k2, nb = b - cm * k1 - ap * k2, nd = r - dm * k1 - dp * k2, ne = e - em * k1 - ep * k2;
		a = na; b = nb; c = nc; r = nd; e = ne;
		GroupMemoryBarrierWithGroupSync();
		SA[t] = a; SB[t] = b; SC[t] = c; SD[t] = r; SE[t] = e;
		GroupMemoryBarrierWithGroupSync();
	}
	float x = r / b;
	if (bCyc)
	{
		const float z = e / b;
		GroupMemoryBarrierWithGroupSync();
		SD[t] = x; SE[t] = z;
		GroupMemoryBarrierWithGroupSync();
		const float Fac = (SD[0] + A0 / Gm * SD[N - 1]) / (1.f + SE[0] + A0 / Gm * SE[N - 1]);
		x -= Fac * z;
	}
	if (t < N)
	{
		const uint k = LineAxis == 0 ? Idx(t, Line) : Idx(Line, t);
		float4 O = UOutRW[k];
		if (LineAxis == 0) { O.y = x; } else { O.z = x; }
		UOutRW[k] = O;
	}
}

[numthreads(8, 8, 1)]
void FixCS(uint3 Tid : SV_DispatchThreadID)
{
	// 서브스텝 끝 (분산): 얕은 칸 운동량 0 · Manning 암시적 — CPU FixDry 와 같다
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const uint k = Idx(i, j);
	const float Dt = TimeRO[0];
	float4 O = UOutRW[k];
	const float h = O.x - BCell(i, j);
	if (h < HDry) { O.y = 0.f; O.z = 0.f; }
	else if (CfAt(i, h) > 0.f)
	{
		const float Uv = sqrt(O.y * O.y + O.z * O.z) / h;
		const float Dn = 1.f + Dt * CfAt(i, h) * Uv / h;   // τ/ρ = c_f |u| u, 암시적
		O.y /= Dn; O.z /= Dn;
	}
	UOutRW[k] = O;
}

[numthreads(64, 1, 1)]
void NestCS(uint3 Tid : SV_DispatchThreadID)
{
	// (바깥 격자) 안쪽 경계 x = NestX 에서 (η, 해안 쪽 u_n = −u, v, 시각) — x 선형 보간
	const uint j = Tid.x;
	if (j >= NY) { return; }
	const float xo = clamp(NestX / Dx - 0.5f, 0.f, (float)NX - 1.001f);
	const uint i0 = (uint)floor(xo); const float f = xo - i0;
	float3 V[2];
	for (uint q = 0; q < 2; ++q)
	{
		const uint i = i0 + q;
		const float4 U = URO[Idx(i, j)];
		const float h = U.x - BCell(i, j);
		V[q] = h > HDry ? float3(U.x - SeaLevel, -U.y / h, U.z / h) : float3(U.x - SeaLevel, 0.f, 0.f);
	}
	NestOutRW[j] = float4(lerp(V[0], V[1], f), TimeRO[2]);
}

// ---------------------------------------------------------------------------------------------
// T3c c6 지하수 (m3-plan c6). 연결 = 젖은 칸 + 지하수면이 바닥에 닿음 → 수두 = 지표 수위, 포화 두께는 바닥까지
static const float GW_EPS = 1e-4f;

void GwHead(uint i, uint j, out float H, out float Hg)
{
	const uint k = Idx(i, j);
	const float w = URO[k].x, B = BCell(i, j), g = GwRO[k].x;
	const bool bConn = w - B > HDry && g >= B - GW_EPS;
	H = bConn ? w : g;
	Hg = max(min(H, B) - GwZaq, 0.f);
}

[numthreads(8, 8, 1)]
void GwFluxCS(uint3 Tid : SV_DispatchThreadID)
{
	// 면 Darcy (Dupuit) q = −K·h̄_gw·ΔH/Δ, 칸 순유입. 바깥 경계 무유량, y 주기면 감싼다
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	float H, Hg;
	GwHead(i, j, H, Hg);
	float Q = 0.f;
	const int2 Nb[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
	[unroll] for (uint n = 0; n < 4; ++n)
	{
		const int a = (int)i + Nb[n].x;
		int b = (int)j + Nb[n].y;
		if (a < 0 || a >= (int)NX) { continue; }
		if (b < 0 || b >= (int)NY) { if (bPeriodicY == 0u) { continue; } b = WJ(b); }
		float Hn, Hgn;
		GwHead((uint)a, (uint)b, Hn, Hgn);
		const float D = n < 2 ? Dx : Dy;
		Q += GwK * 0.5f * (Hg + Hgn) * (Hn - H) / (D * D);
	}
	GwQRW[Idx(i, j)] = Q;
}

[numthreads(8, 8, 1)]
void GwApplyCS(uint3 Tid : SV_DispatchThreadID)
{
	// 연결: Darcy 순유입이 곧 지표와 교환 · 연결 안 됨: 지하수면 갱신 + 침투 (Green–Ampt) + 넘치면 침출. 지표에서 빠진 만큼 hu, hv 같은 비율
	const uint i = Tid.x, j = Tid.y;
	if (i >= NX || j >= NY) { return; }
	const uint k = Idx(i, j);
	const float Dt = TimeRO[0];
	float4 U = UOutRW[k];
	float2 G = GwRW[k];
	const float B = BCell(i, j), h = U.x - B, Qd = GwQRO[k] * Dt;
	if (h > HDry && G.x >= B - GW_EPS)
	{
		const float dW = max(Qd, -h);   // 지표가 모자라면 나머지는 지하수에서
		U.x += dW;
		G = float2(B + min(0.f, Qd - dW) / GwNe, 0.f);
	}
	else
	{
		G.x += Qd / GwNe;
		if (h > HDry)
		{
			const float F = GwK * (1.f + (h + GwPsi) / max(G.y, 1e-3f));
			const float I = clamp(F * Dt, 0.f, min(h, GwNe * max(B - G.x, 0.f)));
			U.x -= I; G.x += I / GwNe; G.y += I / GwNe;
		}
		else { G.y = 0.f; }
		if (G.x > B) { U.x += GwNe * (G.x - B); G.x = B; }
	}
	const float hn = U.x - B;
	if (h > HDry && hn < h) { U.yz *= max(hn, 0.f) / h; }
	UOutRW[k] = U;
	GwRW[k] = G;
}

// Kennedy 와점성 확산 (papers D-M3-19 · m3-plan c9): ∂P/∂t = ∂x(ν ∂x P) + ∂y(ν ∂y P) (FUNWAVE-TVD 식 (1)(2), 교차 미분 없음).
// 5 cm 칸에선 명시적 안정 한계 (Δt ≤ Δx²/4ν ~ 0.6 ms) 가 Δt 보다 작다 → 줄마다 암시적 (후진 오일러, Thomas). x 줄 → y 줄 (Lie 분리).
// 면 ν = 두 칸 평균 (마른 칸은 ν = 0). 줄 끝은 유속 기울기 0.
// Roller 영역 (papers D-M3-22): x 줄마다 ν > 0 칸을 이어진 묶음으로 → 묶음 안 최대 · 최소 수심 H_max · H_min,
// Fr² = H_max(H_max + H_min)/(2H_min²) (Kazolea & Ricchiuto 2018). Fr < 1.3 (Fr² < 1.69) 이면 끔, 아니면
// l_r = 2.9(η_max − η_min), 수치 roller l = 2.5·l_r, |2x − (x_max + x_min)| < l 인 젖은 칸에 ν = h·C2·√(gh) (Bacigaluppi 2019 §4.2).
// x 줄만 (파가 거의 해안 수직) — 줄 하나에 스레드 하나
#define ROLLER_MAX 32
[numthreads(64, 1, 1)]
void RollerCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint j = Tid.x;
	if (j >= NY) { return; }
	float Xa[ROLLER_MAX], Xb[ROLLER_MAX], Lr[ROLLER_MAX], Fz[ROLLER_MAX];
	uint Nc = 0u;
	uint i = 0u;
	while (i < NX && Nc < ROLLER_MAX)
	{
		if (NuRW[Idx(i, j)] <= 0.f) { ++i; continue; }
		float Hx = 0.f, Hn = 1e9f, Ex = -1e9f, En = 1e9f; uint Ix = i, In = i;
		const uint a = i;
		while (i < NX && NuRW[Idx(i, j)] > 0.f)
		{
			const float w = URO[Idx(i, j)].x, h = w - BCell(i, j);
			Hx = max(Hx, h); Hn = min(Hn, h);
			if (w > Ex) { Ex = w; Ix = i; }
			if (w < En) { En = w; In = i; }
			++i;
		}
		Hn = max(Hn, HDry);
		Xa[Nc] = (float)Ix; Xb[Nc] = (float)In; Lr[Nc] = 2.5f * 2.9f * (Ex - En) / Dx;   // 칸 단위
		Fz[Nc] = Hx * (Hx + Hn) / (2.f * Hn * Hn) >= 1.69f ? 1.f : 0.f;
		if (Fz[Nc] == 0.f) { for (uint k = a; k < i; ++k) { NuRW[Idx(k, j)] = 0.f; } }
		++Nc;
	}
	for (uint c = 0u; c < Nc; ++c)
	{
		if (Fz[c] == 0.f) { continue; }
		const float S = Xa[c] + Xb[c], L = max(Lr[c], 1.f);
		const int k0 = max((int)floor(0.5f * (S - L)), 0), k1 = min((int)ceil(0.5f * (S + L)), (int)NX - 1);
		for (int k = k0; k <= k1; ++k)
		{
			if (abs(2.f * (float)k - S) >= L) { continue; }
			const float h = URO[Idx((uint)k, j)].x - BCell((uint)k, j);
			if (h > HDry && SeaLevel - BCell((uint)k, j) > HDry) { NuRW[Idx((uint)k, j)] = max(NuRW[Idx((uint)k, j)], h * BreakStop * sqrt(Gravity * h)); }
		}
	}
	const float Dt = TimeRO[0];
	for (uint k = 0u; k < NX; ++k) { if (NuRW[Idx(k, j)] > 0.f) { BrkDiagRW[Idx(k, j)].x += Dt; } }   // 진단: ν > 0 누적 시간 (roller 포함)
}

uint EddyNext(uint L, uint s) { return LineAxis == 0u ? Idx(s, L) : Idx(L, s); }
float EddyFace(float A, float B) { return 0.5f * (A + B); }   // FUNWAVE 와 같이 칸 ν 평균 — "양쪽 다 > 0" 이면 1~2 칸 폭 앞면 띠에서 확산이 0 이 됐다 (m3-log #23)
[numthreads(64, 1, 1)]
void EddyCS(uint3 Tid : SV_DispatchThreadID)
{
	const uint L = Tid.x, Len = LineAxis == 0u ? NX : NY, Cnt = LineAxis == 0u ? NY : NX;
	if (L >= Cnt) { return; }
	const float D = LineAxis == 0u ? Dx : Dy, r = TimeRO[0] / (D * D);
	float Cp = 0.f; float2 Dp = 0.f;
	for (uint s = 0u; s < Len; ++s)
	{
		const uint k = EddyNext(L, s);
		const float Nc = NuRO[k];
		const float Nl = s > 0u ? EddyFace(Nc, NuRO[EddyNext(L, s - 1u)]) : 0.f;
		const float Nr = s + 1u < Len ? EddyFace(Nc, NuRO[EddyNext(L, s + 1u)]) : 0.f;
		const float a = -r * Nl, c = -r * Nr, b = 1.f + r * (Nl + Nr);
		const float m = b - a * Cp;
		Cp = c / m; Dp = (UOutRW[k].yz - a * Dp) / m;
		EdCRW[k] = Cp; EdDRW[k] = Dp;
	}
	float2 X = 0.f;
	for (int t = (int)Len - 1; t >= 0; --t)
	{
		const uint k = EddyNext(L, (uint)t);
		X = EdDRW[k] - EdCRW[k] * X;
		float4 U = UOutRW[k]; U.yz = X; UOutRW[k] = U;
	}
}
